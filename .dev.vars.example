# Cloudflare Pages Functions 环境变量示例（不要提交真实密钥）
# 本地开发：复制为 .dev.vars 并填入真实值；线上在 Cloudflare Dashboard 配置。
#
# 本地起服务测试：npx wrangler pages dev docs

# 必填：模型服务 API Key（DeepSeek 在 https://platform.deepseek.com 申请）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 选填：默认 DeepSeek。换成通义/智谱等兼容服务时改这三个，不用改代码
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 留言板相关（提交 GitHub Issue 用）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
