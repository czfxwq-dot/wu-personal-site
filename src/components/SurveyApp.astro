---
// SurveyApp.astro — 家长决策调查容器
// 通过 window.__SURVEY_LANG__ 传递语言配置给客户端脚本
interface Props { lang: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props as Props;
---

<style is:global src="../../styles/survey.css" />

<div id="survey-app" data-lang={lang}></div>

<script>
  // 将语言配置注入全局，供 survey-app.ts 读取
  (window as any).__SURVEY_LANG__ = document.getElementById('survey-app')?.dataset.lang || 'zh';
</script>

<script src="./survey-app.ts"></script>
