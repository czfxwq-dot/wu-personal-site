    title: 'Parental Decision-Making & Psychological Responses Survey',
    intro: [
      'This study examines how parents make judgments for their children in simulated scenarios, and their feelings during the process.',
      'There are no right or wrong answers. Please respond based on your first instinct. Your responses are anonymous and used for research only.',
      'The survey takes approximately 15–20 minutes. Please complete each section in order.'
    ],
    agree: 'I have read and agree to participate',
    start: 'Start Survey',
    progress: 'Page {c} of {t}',
    prev: 'Previous', next: 'Next', submit: 'Submit Survey',
    thanks: 'Thank you for your participation!',
    thanksMsg: 'Your response has been submitted successfully.',
    panasTitle: 'Please indicate how much you feel each emotion right now.',
    scenarioIntro: 'In each scenario, you are a parent facing a decision about your child. There are no right or wrong answers.',
    confidence: 'How confident are you in your choice?',
    happiness: 'How would this choice affect your child\'s happiness?',
    openQ: 'What do you value most in these decisions? Recall a similar real experience — what did you choose and why?',
    openPlaceholder: 'Share your thoughts (optional)…',
    mathQ: 'Please calculate: 37 + 46 = ?',
    mathPlaceholder: 'Enter your answer',
    confAnchors: ['Not at all confident', 'Moderate', 'Very confident'],
    hapAnchors: ['Significantly decrease', 'No effect', 'Significantly increase'],
    gender: 'Your gender', age: 'Your age', edu: 'Highest education', child: 'Do you have children',
    genderOpts: ['Male', 'Female', 'Other / Prefer not to say'],
    ageOpts: ['Under 25', '25-30', '31-35', '36-40', '41-45', '46+'],
    eduOpts: ['High school or below', 'Associate', 'Bachelor', 'Master', 'PhD+'],
