const SCENARIOS = [
  { no:1, sit:{zh:'你正在考虑，是否让孩子从现在住的二线城市搬到一线城市读书。',en:'You are considering whether to move your child from a second-tier city to a first-tier city for better education.'},
    a:{label:{zh:'搬到一线城市',en:'Move to a first-tier city'},pros:{zh:['更好的教育资源'],en:['Better educational resources']},cons:{zh:['学费约16,000元/年','全家需适应陌生环境'],en:['Tuition ~¥16,000/year','Family must adapt to new environment']}},
    b:{label:{zh:'留在现在的城市',en:'Stay in the current city'},pros:{zh:['学费约1,600元/年','生活环境熟悉'],en:['Tuition ~¥1,600/year','Familiar environment']},cons:{zh:['教育资源相对普通'],en:['Educational resources are ordinary']}}},
  { no:3, sit:{zh:'孩子成绩一般，不好不坏。家庭可以承担一种额外课程。',en:'Your child\'s grades are average. Your family can afford one extra course.'},
    a:{label:{zh:'报名学科补习班',en:'Academic tutoring'},pros:{zh:['帮助提高学习成绩'],en:['Improves academic performance']},cons:{zh:['休息和兴趣时间减少'],en:['Less time for rest and hobbies']}},
    b:{label:{zh:'报名兴趣班',en:'Hobby class'},pros:{zh:['发展个人特长'],en:['Develops personal strengths']},cons:{zh:['可能影响学业'],en:['May affect academics']}}},
  { no:5, sit:{zh:'孩子有机会进入学习要求更高的尖子班，也可以继续留在目前表现不错的普通班。',en:'Your child can enter a more demanding honors class, or stay in the regular class.'},
    a:{label:{zh:'进入尖子班',en:'Enter honors class'},pros:{zh:['更有挑战性的学习环境'],en:['More challenging environment']},cons:{zh:['压力增加','自由时间减少'],en:['More pressure','Less free time']}},
    b:{label:{zh:'留在普通班',en:'Stay in regular class'},pros:{zh:['压力较小','保持较好表现'],en:['Less pressure','Maintain performance']},cons:{zh:['挑战性有限'],en:['Limited challenge']}}},
  { no:6, sit:{zh:'孩子最近一次考试成绩低于预期。',en:'Your child\'s most recent exam was below expectations.'},
    a:{label:{zh:'让孩子自己调整',en:'Let child adjust independently'},pros:{zh:['压力较小'],en:['Less pressure']},cons:{zh:['改善可能有限'],en:['Limited improvement']}},
    b:{label:{zh:'安排补习老师',en:'Arrange a tutor'},pros:{zh:['可能改善成绩'],en:['May improve grades']},cons:{zh:['增加压力','减少自由时间'],en:['More pressure','Less free time']}}},
  { no:8, sit:{zh:'临近考试，你正在考虑是否暂停孩子原本参加的兴趣活动。',en:'Exams are approaching. Considering pausing your child\'s extracurricular activities.'},
    a:{label:{zh:'暂停兴趣活动',en:'Pause activities'},pros:{zh:['更多复习时间'],en:['More prep time']},cons:{zh:['可能增加压力影响情绪'],en:['May increase stress']}},
    b:{label:{zh:'保留兴趣活动',en:'Keep activities'},pros:{zh:['继续放松快乐'],en:['Continue to relax']},cons:{zh:['复习时间减少'],en:['Less prep time']}}},
  { no:9, sit:{zh:'学校组织户外自然探索活动，家长无法陪同。',en:'School organized an outdoor nature trip. Parents cannot accompany.'},
    a:{label:{zh:'让孩子参加',en:'Let child participate'},pros:{zh:['接触自然体验新活动'],en:['Experience nature']},cons:{zh:['存在一定受伤风险'],en:['Some injury risk']}},
    b:{label:{zh:'不让孩子参加',en:'Don\'t let child participate'},pros:{zh:['减少安全担忧'],en:['Reduce safety concerns']},cons:{zh:['错过探索机会'],en:['Miss exploration opportunity']}}},
  { no:13, sit:{zh:'孩子在考试中看到同学作弊，回家后告诉了你。',en:'Your child saw a classmate cheating and told you.'},
    a:{label:{zh:'建议向老师说明',en:'Report to teacher'},pros:{zh:['坚持规则'],en:['Uphold rules']},cons:{zh:['可能影响同学关系'],en:['May affect peer relations']}},
    b:{label:{zh:'建议暂时不报告',en:'Don\'t report for now'},pros:{zh:['避免卷入矛盾'],en:['Avoid conflicts']},cons:{zh:['作弊可能得不到处理'],en:['Cheating unaddressed']}}},
  { no:14, sit:{zh:'孩子课外更喜欢漫画，但经典读物对语文更有帮助。只能优先选一种。',en:'Your child prefers comics but classics help language more. Can only prioritize one.'},
    a:{label:{zh:'允许主要读漫画',en:'Allow comics'},pros:{zh:['保持阅读兴趣'],en:['Maintain interest']},cons:{zh:['对语文帮助较少'],en:['Less help for language']}},
    b:{label:{zh:'要求主要读经典',en:'Require classics'},pros:{zh:['提高阅读写作能力'],en:['Improve skills']},cons:{zh:['兴趣可能降低'],en:['Interest may decline']}}},
  { no:16, sit:{zh:'身边有家庭让孩子出国读书，考虑是否让孩子小学阶段出国。',en:'Some families send children abroad. Considering elementary school abroad.'},
    a:{label:{zh:'让孩子出国',en:'Send child abroad'},pros:{zh:['接触不同教育文化'],en:['Different education/culture']},cons:{zh:['费用高','适应安全分离问题'],en:['High cost','Adaptation/safety issues']}},
    b:{label:{zh:'在国内读书',en:'Stay domestic'},pros:{zh:['费用低','环境熟悉方便陪伴'],en:['Lower cost','Familiar']}},cons:{zh:['国际化机会少'],en:['Fewer international opportunities']}}},
  { no:17, sit:{zh:'孩子告诉你，最近在学校受到同学排挤和孤立。',en:'Your child reports being excluded by classmates.'},
    a:{label:{zh:'主动联系老师',en:'Contact teacher'},pros:{zh:['借助专业力量'],en:['Professional help']},cons:{zh:['孩子可能觉得过度介入'],en:['Child may feel overstepped']}},
    b:{label:{zh:'鼓励自己处理',en:'Encourage self-handling'},pros:{zh:['锻炼人际能力'],en:['Build skills']},cons:{zh:['问题可能加重'],en:['Problem may worsen']}}},
  { no:18, sit:{zh:'孩子没生病，但精神状态不佳，想请假一天。',en:'Your child isn\'t sick but feels off and wants a day off.'},
    a:{label:{zh:'允许请假',en:'Allow day off'},pros:{zh:['调整状态'],en:['Let child recover']},cons:{zh:['错过课程'],en:['Miss classes']}},
    b:{label:{zh:'不允许请假',en:'Don\'t allow'},pros:{zh:'不影响进度',en:'Stay on track'},cons:{zh:'无法得到休息',en:'No needed rest'}}},
  { no:21, sit:{zh:'孩子比赛失败后情绪低落，不想再参加类似比赛。',en:'Your child is down after losing and doesn\'t want to compete again.'},
    a:{label:{zh:'鼓励继续尝试',en:'Encourage to keep trying'},pros:{zh:['学习面对失败'],en:['Learn from failure']},cons:{zh:'增加压力',en:'More stress'}},
    b:{label:{zh:'尊重暂时退出',en:'Respect withdrawal'},pros:{zh:'获得调整时间',en:'Time to recover'},cons:{zh:'减少锻炼坚持的机会',en:'Less perseverance practice'}}},
  { no:22, sit:{zh:'孩子希望有更多个人空间，比如在房间关门学习或休息。',en:'Your child wants more personal space, like closing their door.'},
    a:{label:{zh:'允许关门，约定规则',en:'Allow with rules'},pros:{zh:'尊重隐私',en:'Respect privacy'},cons:{zh:'不能随时了解情况',en:'Can\'t monitor always'}},
    b:{label:{zh:'要求保持开门',en:'Keep door open'},pros:{zh:'便于监督',en:'Easier to monitor'},cons:{zh:'减少隐私自主',en:'Less privacy/autonomy'}}},
];

const STEPS = ['intro','panas','dec1','dec2','dec3','final','thanks'];
const TOTAL = 6; // intro不计入进度

// ===== 状态管理 =====
const STORAGE_KEY = 'survey_state';
let state = loadState();
const t = TEXT[lang];

function loadState() {
  try {
    const s = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    if (s.step && STEPS.includes(s.step)) return s;
  } catch {}
  return { step: 'intro', consent: false, panas: {}, decisions: {}, openText: '', mathAnswer: '', demo: {} };
}
function saveState() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }

// ===== 渲染 =====
const app = document.getElementById('survey-app');

function render() {
  saveState();
  switch(state.step) {
    case 'intro': renderIntro(); break;
    case 'panas': renderPanas(); break;
    case 'dec1': renderDecisions(0, 4); break;
    case 'dec2': renderDecisions(4, 8); break;
    case 'dec3': renderDecisions(8, 13); break;
    case 'final': renderFinal(); break;
    case 'thanks': renderThanks(); break;
  }
}

function wrap(html) {
  return `<div class="survey-wrapper">${progressHTML()}${html}${navHTML()}</div>`;
}

function progressHTML() {
  if (state.step === 'intro' || state.step === 'thanks') return '';
  const idx = STEPS.indexOf(state.step);
  const p = Math.min(Math.max((idx - 1) / (TOTAL - 1), 0), 1);
  const label = t.progress.replace('{c}', Math.min(idx, TOTAL)).replace('{t}', TOTAL);
  return `<div class="survey-progress"><span>${label}</span><div class="survey-progress-bar"><div class="survey-progress-fill" style="width:${p*100}%"></div></div></div>`;
}

function navHTML() {
  if (state.step === 'intro' || state.step === 'thanks') return '';
  let html = '<div class="survey-nav">';
  if (state.step !== 'panas') html += `<button class="survey-btn survey-btn-ghost" id="btn-prev">${t.prev}</button>`;
  else html += '<div></div>';
  if (state.step === 'final') html += `<button class="survey-btn survey-btn-primary" id="btn-next">${t.submit}</button>`;
  else html += `<button class="survey-btn survey-btn-primary" id="btn-next">${t.next}</button>`;
  html += '</div><div class="survey-error" id="survey-error">' + t.required + '</div>';
  return html;
}

// Step: Intro
function renderIntro() {
  app.innerHTML = wrap(`
    <div class="survey-step active">
      <h1 class="survey-h1">${t.title}</h1>
      ${t.intro.map(p => `<p class="survey-p">${p}</p>`).join('')}
      <label class="survey-checkbox ${state.consent?'checked':''}" id="consent-label" style="margin-top:24px;">
        <input type="checkbox" id="consent-check" ${state.consent?'checked':''}>
        <span>${t.agree}</span>
      </label>
      <div style="margin-top:24px;text-align:center;">
        <button class="survey-btn survey-btn-primary" id="btn-start" ${state.consent?'':'disabled'}>${t.start}</button>
      </div>
    </div>
  `);
  document.getElementById('consent-label').onclick = () => {
    state.consent = !state.consent;
    document.getElementById('consent-check').checked = state.consent;
    document.getElementById('consent-label').classList.toggle('checked', state.consent);
    document.getElementById('btn-start').disabled = !state.consent;
    saveState();
  };
  document.getElementById('btn-start').onclick = () => { if(state.consent){ state.step='panas'; render(); }};
}

// Step: PANAS
function renderPanas() {
  const items = t.panasItems;
  const scale = t.panasScale;
  let html = '<div class="survey-step active">';
  html += `<h2 class="survey-h1" style="font-size:20px;">PANAS</h2>`;
  html += `<p class="survey-p">${t.panasTitle}</p>`;
  html += '<div class="survey-card">';
  items.forEach((item, i) => {
    const val = state.panas[i] || 0;
    html += `<div class="panas-item"><div class="panas-label">${item}</div><div class="panas-options">`;
    scale.forEach((s, j) => {
      html += `<button class="panas-opt ${val===j+1?'selected':''}" data-i="${i}" data-v="${j+1}">${s}</button>`;
    });
    html += '</div></div>';
  });
  html += '</div></div>';
  app.innerHTML = wrap(html);
  app.querySelectorAll('.panas-opt').forEach(btn => {
    btn.onclick = () => {
      const i = btn.dataset.i, v = parseInt(btn.dataset.v);
      state.panas[i] = v;
      btn.parentElement.querySelectorAll('.panas-opt').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      saveState();
    };
  });
  bindNav();
}

// Step: Decisions
function renderDecisions(start, end) {
  const slice = SCENARIOS.slice(start, end);
  let html = '<div class="survey-step active">';
  if (start === 0) html += `<p class="survey-p">${t.scenarioIntro}</p>`;
  slice.forEach((sc, idx) => {
    const gi = start + idx; // global index
    const d = state.decisions[gi] || {};
    const s = sc.sit[lang];
    const aLabel = sc.a.label[lang], bLabel = sc.b.label[lang];
    const aPros = sc.a.pros[lang].map(p=>'✅ '+p).join('<br>');
    const aCons = sc.a.cons[lang].map(c=>'❌ '+c).join('<br>');
    const bPros = sc.b.pros[lang].map(p=>'✅ '+p).join('<br>');
    const bCons = sc.b.cons[lang].map(c=>'❌ '+c).join('<br>');
    html += `<div class="survey-card">`;
    html += `<div class="scenario-situation">${s}</div>`;
    html += `<label class="scenario-option ${d.choice==='A'?'selected':''}" data-gi="${gi}" data-c="A">`;
    html += `<input type="radio" name="q${gi}" ${d.choice==='A'?'checked':''}><div class="scenario-option-text"><div class="scenario-option-label">A. ${aLabel}</div><div class="scenario-pros">${aPros}</div><div class="scenario-cons">${aCons}</div></div></label>`;
    html += `<label class="scenario-option ${d.choice==='B'?'selected':''}" data-gi="${gi}" data-c="B">`;
    html += `<input type="radio" name="q${gi}" ${d.choice==='B'?'checked':''}><div class="scenario-option-text"><div class="scenario-option-label">B. ${bLabel}</div><div class="scenario-pros">${bPros}</div><div class="scenario-cons">${bCons}</div></div></label>`;
    // Confidence slider
    html += `<div class="followup-q"><div class="followup-label">${t.confidence}</div>`;
    html += `<div class="slider-row"><span style="font-size:12px;color:var(--color-text-tertiary)">1</span><input type="range" min="1" max="7" value="${d.confidence||4}" data-gi="${gi}" data-f="confidence"><span class="slider-val" id="conf-val-${gi}">${d.confidence||4}</span><span style="font-size:12px;color:var(--color-text-tertiary)">7</span></div>`;
    html += `<div class="slider-anchors"><span>${t.confAnchors[0]}</span><span>${t.confAnchors[1]}</span><span>${t.confAnchors[2]}</span></div></div>`;
    // Happiness slider
    html += `<div class="followup-q"><div class="followup-label">${t.happiness}</div>`;
    html += `<div class="slider-row"><span style="font-size:12px;color:var(--color-text-tertiary)">1</span><input type="range" min="1" max="7" value="${d.happiness||4}" data-gi="${gi}" data-f="happiness"><span class="slider-val" id="hap-val-${gi}">${d.happiness||4}</span><span style="font-size:12px;color:var(--color-text-tertiary)">7</span></div>`;
    html += `<div class="slider-anchors"><span>${t.hapAnchors[0]}</span><span>${t.hapAnchors[1]}</span><span>${t.hapAnchors[2]}</span></div></div>`;
    html += '</div>';
  });
  html += '</div>';
  app.innerHTML = wrap(html);

  // Option clicks
  app.querySelectorAll('.scenario-option').forEach(el => {
    el.onclick = (e) => {
      if (e.target.tagName === 'INPUT') return;
      const gi = el.dataset.gi, c = el.dataset.c;
      if (!state.decisions[gi]) state.decisions[gi] = { confidence: 4, happiness: 4 };
      state.decisions[gi].choice = c;
      el.parentElement.querySelectorAll('.scenario-option').forEach(o => o.classList.remove('selected'));
      el.classList.add('selected');
      el.querySelector('input').checked = true;
      saveState();
    };
  });
  // Slider changes
  app.querySelectorAll('input[type=range]').forEach(sl => {
    sl.oninput = () => {
      const gi = sl.dataset.gi, f = sl.dataset.f;
      if (!state.decisions[gi]) state.decisions[gi] = { confidence: 4, happiness: 4 };
      state.decisions[gi][f] = parseInt(sl.value);
      document.getElementById(`${f==='confidence'?'conf':'hap'}-val-${gi}`).textContent = sl.value;
      saveState();
    };
  });
  bindNav();
}

// Step: Final
function renderFinal() {
  const d = state.demo || {};
  let html = '<div class="survey-step active">';
  // Open question
  html += `<div class="survey-card"><h3 style="margin-bottom:12px;font-size:16px;">${t.openQ}</h3>`;
  html += `<textarea class="survey-textarea" id="open-text" placeholder="${t.openPlaceholder}">${state.openText||''}</textarea></div>`;
  // Math
  html += `<div class="survey-card"><h3 style="margin-bottom:12px;font-size:16px;">${t.mathQ}</h3>`;
  html += `<input class="survey-input" id="math-answer" type="number" placeholder="${t.mathPlaceholder}" value="${state.mathAnswer||''}"></div>`;
  // Demographics
  html += '<div class="survey-card">';
  html += demoGroup('gender', t.gender, t.genderOpts, d.gender);
  html += demoGroup('age', t.age, t.ageOpts, d.age);
  html += demoGroup('edu', t.edu, t.eduOpts, d.edu);
  html += demoGroup('child', t.child, t.childOpts, d.child);
  html += '</div></div>';
  app.innerHTML = wrap(html);

  document.getElementById('open-text').oninput = (e) => { state.openText = e.target.value; saveState(); };
  document.getElementById('math-answer').oninput = (e) => { state.mathAnswer = e.target.value; saveState(); };
  app.querySelectorAll('.demo-opt').forEach(el => {
    el.onclick = () => {
      const field = el.dataset.field, val = el.dataset.val;
      state.demo[field] = val;
      el.parentElement.querySelectorAll('.demo-opt').forEach(o => o.classList.remove('selected'));
      el.classList.add('selected');
      saveState();
    };
  });
  bindNav(true);
}

function demoGroup(field, label, opts, selected) {
  let h = `<div class="demo-group"><div class="demo-label">${label}</div><div class="demo-options">`;
  opts.forEach((o, i) => {
    h += `<div class="demo-opt ${selected===String(i)?'selected':''}" data-field="${field}" data-val="${i}">${o}</div>`;
  });
  return h + '</div></div>';
}

// Step: Thanks
function renderThanks() {
  app.innerHTML = `<div class="survey-wrapper">
    <div class="thanks-icon">🎉</div>
    <div class="thanks-title">${t.thanks}</div>
    <div class="thanks-msg">${t.thanksMsg}</div>
  </div>`;
}

// Navigation
function bindNav(isFinal) {
  const prev = document.getElementById('btn-prev');
  const next = document.getElementById('btn-next');
  const err = document.getElementById('survey-error');
  if (prev) prev.onclick = goPrev;
  if (next) next.onclick = () => {
    if (!validate()) { err.classList.add('show'); return; }
    err.classList.remove('show');
    if (isFinal) submitSurvey();
    else goNext();
  };
}

function goNext() {
  const idx = STEPS.indexOf(state.step);
  if (idx < STEPS.length - 1) { state.step = STEPS[idx + 1]; render(); window.scrollTo(0, 0); }
}
function goPrev() {
  const idx = STEPS.indexOf(state.step);
  if (idx > 1) { state.step = STEPS[idx - 1]; render(); window.scrollTo(0, 0); }
}

function validate() {
  const step = state.step;
  if (step === 'panas') return Object.keys(state.panas).length >= 10;
  if (step.startsWith('dec')) {
    const ranges = { dec1: [0,4], dec2: [4,8], dec3: [8,13] };
    const [s, e] = ranges[step];
    for (let i = s; i < e; i++) {
      if (!state.decisions[i] || !state.decisions[i].choice) return false;
    }
    return true;
  }
  if (step === 'final') {
    if (state.demo.gender === undefined || state.demo.age === undefined ||
        state.demo.edu === undefined || state.demo.child === undefined) return false;
    return true;
  }
  return true;
}

async function submitSurvey() {
  const btn = document.getElementById('btn-next');
  btn.disabled = true;
  btn.textContent = t.submitting;
  const err = document.getElementById('survey-error');

  // Generate session ID
  let sessionId = localStorage.getItem('survey_session');
  if (!sessionId) { sessionId = 's_' + Date.now() + '_' + Math.random().toString(36).slice(2,8); localStorage.setItem('survey_session', sessionId); }

  const payload = {
    session_id: sessionId,
    lang,
    duration_sec: state.duration || Math.round((Date.now() - (state.start_time || Date.now())) / 1000),
    start_time: state.start_time || Date.now(),
    panas: state.panas,
    decisions: state.decisions,
    open_text: state.openText || '',
    math_answer: parseInt(state.mathAnswer) || 0,
    demographics: state.demo,
  };

  try {
    const res = await fetch('/api/survey/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      localStorage.removeItem(STORAGE_KEY);
      state.step = 'thanks';
      render();
    } else {
      err.textContent = data.error || t.error;
      err.classList.add('show');
    }
  } catch {
    err.textContent = t.error;
    err.classList.add('show');
  }
  btn.disabled = false;
  btn.textContent = t.submit;
}

// Track start time
if (!state.start_time) { state.start_time = Date.now(); saveState(); }

render();
</script>
