---
// SurveyApp.astro — 家长决策调查客户端应用
// 接收 lang prop ('zh' | 'en')，管理全部6步流程
interface Props { lang: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props as Props;
---

<div id="survey-app" data-lang={lang}></div>

<style>
  /* === 调查专用样式 === */
  .survey-wrapper {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 16px 48px;
    font-family: var(--font-sans);
    color: var(--color-text);
  }
  .survey-progress {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .survey-progress-bar {
    flex: 1;
    height: 6px;
    background: var(--color-border-light);
    border-radius: 3px;
    overflow: hidden;
  }
  .survey-progress-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: 3px;
    transition: width 0.4s ease;
  }
  .survey-step { display: none; }
  .survey-step.active { display: block; animation: fadeIn 0.35s ease; }
  .survey-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
  }
  .survey-h1 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .survey-p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }
  .survey-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .survey-btn-primary {
    background: var(--color-accent);
    color: #fff;
  }
  .survey-btn-primary:hover { background: var(--color-accent-hover); }
  .survey-btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
  .survey-btn-ghost {
    background: transparent;
    border: 1.5px solid var(--color-border);
    color: var(--color-text-secondary);
  }
  .survey-btn-ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .survey-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
    gap: 12px;
  }
  /* 复选框 */
  .survey-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 15px;
  }
  .survey-checkbox:hover { border-color: var(--color-accent-light); }
  .survey-checkbox.checked { border-color: var(--color-accent); background: rgba(45,53,97,0.04); }
  .survey-checkbox input { margin-top: 2px; accent-color: var(--color-accent); }
  /* PANAS 量表 */
  .panas-item {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .panas-item:last-child { border-bottom: none; }
  .panas-label { font-size: 15px; font-weight: 500; margin-bottom: 10px; }
  .panas-options {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .panas-opt {
    flex: 1;
    min-width: 60px;
    padding: 8px 4px;
    text-align: center;
    font-size: 13px;
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    background: transparent;
    color: var(--color-text-secondary);
  }
  .panas-opt:hover { border-color: var(--color-accent-light); }
  .panas-opt.selected {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
  }
  /* 情景题 */
  .scenario-situation {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 3px solid var(--color-gold);
  }
  .scenario-option {
    padding: 14px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .scenario-option:hover { border-color: var(--color-accent-light); background: rgba(45,53,97,0.02); }
  .scenario-option.selected { border-color: var(--color-accent); background: rgba(45,53,97,0.04); }
  .scenario-option input { margin-top: 3px; accent-color: var(--color-accent); }
  .scenario-option-text { flex: 1; }
  .scenario-option-label { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
  .scenario-pros { color: var(--color-success); font-size: 13px; margin-top: 4px; }
  .scenario-cons { color: var(--color-danger); font-size: 13px; margin-top: 2px; }
  /* 滑块追问 */
  .followup-q { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border-light); }
  .followup-label { font-size: 14px; font-weight: 500; margin-bottom: 10px; }
  .slider-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .slider-row input[type=range] {
    flex: 1;
    accent-color: var(--color-accent);
    height: 6px;
  }
  .slider-val {
    min-width: 24px;
    text-align: center;
    font-weight: 700;
    font-size: 18px;
    color: var(--color-accent);
  }
  .slider-anchors {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--color-text-tertiary);
    margin-top: 4px;
  }
  /* 人口统计 */
  .demo-group { margin-bottom: 20px; }
  .demo-label { font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .demo-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .demo-opt {
    padding: 8px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .demo-opt:hover { border-color: var(--color-accent-light); }
  .demo-opt.selected { border-color: var(--color-accent); background: var(--color-accent); color: #fff; }
  .demo-opt input { display: none; }
  /* 文本框 */
  .survey-textarea {
    width: 100%;
    min-height: 120px;
    padding: 12px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    background: var(--color-bg);
    color: var(--color-text);
    box-sizing: border-box;
  }
  .survey-textarea:focus { outline: none; border-color: var(--color-accent); }
  .survey-input {
    width: 100%;
    padding: 10px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    font-size: 14px;
    background: var(--color-bg);
    color: var(--color-text);
    box-sizing: border-box;
  }
  .survey-input:focus { outline: none; border-color: var(--color-accent); }
  /* 错误提示 */
  .survey-error {
    color: var(--color-danger);
    font-size: 13px;
    margin-top: 8px;
    display: none;
  }
  .survey-error.show { display: block; }
  /* 感谢页 */
  .thanks-icon { font-size: 48px; text-align: center; margin-bottom: 16px; }
  .thanks-title { text-align: center; font-size: 22px; font-weight: 700; margin-bottom: 12px; }
  .thanks-msg { text-align: center; font-size: 15px; color: var(--color-text-secondary); }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 480px) {
    .survey-wrapper { padding: 16px 12px 40px; }
    .survey-card { padding: 18px; }
    .survey-h1 { font-size: 20px; }
    .panas-options { gap: 4px; }
    .panas-opt { min-width: 50px; font-size: 12px; padding: 6px 2px; }
  }
</style>

<script define:vars={{ lang }}>
// ===== 调查数据 =====
const TEXT = {
  zh: {
    title: '模拟情境下的家长决策与心理感受调查',
    intro: [
      '本研究关注家长在不同模拟情境中如何为孩子作出判断，以及作答过程中的感受和想法。',
