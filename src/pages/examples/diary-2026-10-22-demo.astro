---
// 示例：使用新的 i18n 数据结构的日记页面模板
// 这个模板会根据 URL 自动显示对应语言的内容

import BaseLayout from '../../layouts/Base.astro';
import { diary20261022 } from '../../data/examples/diary-2026-10-22-example';

// 从 URL 获取当前语言
const url = new URL(Astro.request.url);
const pathSegments = url.pathname.split('/').filter(Boolean);
const currentLang = pathSegments[0] === 'en' ? 'en' : 'zh';

// 获取对应语言的内容
const content = diary20261022[currentLang];
const otherLang = currentLang === 'zh' ? 'en' : 'zh';

// 生成 SEO 元数据
const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": content.title,
  "datePublished": "2026-10-22",
  "dateModified": "2026-10-22",
  "description": content.summary,
  "author": {
    "@type": "Person",
    "name": currentLang === 'zh' ? "吴总" : "Mr. Wu",
    "alternateName": currentLang === 'zh' ? "观吾" : "Guanwu"
  },
  "inLanguage": currentLang
};
---

<BaseLayout
  title={`${content.title} | 观吾日记`}
  jsonLd={diaryJsonLd}
  ogDescription={content.summary}
  navActive="diary"
  lang={currentLang}
>
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-10-22">
        {currentLang === 'zh' ? '2026年10月22日' : 'October 22, 2026'}
      </time>
      <span class="diary-day">{content.title}</span>

      <!-- 语言切换按钮 -->
      <a
        href={currentLang === 'zh' ? '/en/diary/2026-10-22/' : '/diary/2026-10-22/'}
        class="lang-switch"
        title={currentLang === 'zh' ? 'Switch to English' : '切换到中文'}
      >
        {currentLang === 'zh' ? '🇬🇧 EN' : '🇨🇳 中文'}
      </a>
    </header>

    <!-- 使用 set:html 渲染 HTML 内容 -->
    <div class="diary-content" set:html={content.content}>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href={currentLang === 'zh' ? '/diary/2026-10-21/' : '/en/diary/2026-10-21/'} class="prev">
          {currentLang === 'zh' ? '← 前一天' : '← Previous Day'}
        </a>
        <a href={currentLang === 'zh' ? '/diary/' : '/en/diary/'} class="all">
          {currentLang === 'zh' ? '所有日记' : 'All Entries'}
        </a>
        <a href={currentLang === 'zh' ? '/diary/2026-10-23/' : '/en/diary/2026-10-23/'} class="next">
          {currentLang === 'zh' ? '后一天 →' : 'Next Day →'}
        </a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1.5rem;
    position: relative;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .lang-switch {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary, #f3f4f6);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--text-primary, #111827);
    font-size: 0.875rem;
    transition: background 0.2s;
  }
  .lang-switch:hover {
    background: var(--bg-tertiary, #e5e7eb);
  }
  .diary-content {
    line-height: 1.8;
    font-size: 1.0625rem;
  }
  .diary-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
  }
  .diary-content :global(p) {
    margin: 1.5rem 0;
  }
  .diary-content :global(ul),
  .diary-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 2rem;
  }
  .diary-content :global(li) {
    margin: 0.5rem 0;
  }
  .diary-content :global(strong) {
    font-weight: 600;
    color: var(--text-primary, #111827);
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .diary-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .diary-nav :global(a) {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .diary-nav :global(a:hover) {
    color: var(--text-primary, #111827);
  }
</style>
