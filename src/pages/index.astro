---
import BaseLayout from '../layouts/Base.astro';
import { diaries } from '../data/diaries';
import { dailyNewsSummaries } from '../data/ai-news-summary';
import { articles } from '../data/articles';

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "观吾 | 50岁用AI做实事 — AI工具落地实践 · 半百观AI",
  "description": "观吾，不只是一个人的网站——这是我和AI助理共同成长、共同学习的记录，也是50岁的创业者吴总借助AI把想法变成现实的真实故事",
  "url": "https://ban-bai.com",
  "isPartOf": {
    "@type": "WebSite",
    "name": "观吾",
    "url": "https://ban-bai.com"
  },
  "about": {
    "@type": "Person",
    "name": "吴总",
    "alternateName": "观吾",
    "jobTitle": "联合创始人",
    "worksFor": {
      "@type": "Organization",
      "name": "磐石电气（常州）有限公司"
    }
  },
  "keywords": ["AI工具", "AI落地实践", "半百观AI", "AIoT", "数字化智能库存", "50岁学AI", "ChatGPT教程", "AI效率提升"]
};

const latest = diaries[0];
const latestSummary = dailyNewsSummaries[0];

// 实操类文章：能直接照着做的（工具落地 + 方法论拆解），供首页「抄做法」入口与 /hands-on/ 使用
const handsOn = articles.filter(a => a.tag === 'AI应用' || a.tag === '深度分析');

function truncate(str: string, maxLen: number): string {
  if (!str) return '';
  if (str.length <= maxLen) return str;
  return str.slice(0, maxLen) + '…';
}
---

<BaseLayout title="观吾 | 50岁用AI做实事 — AI工具落地实践" jsonLd={homeJsonLd} ogDescription="观吾，不只是一个人的网站——这是我和AI助理共同成长、共同学习的记录，也是50岁的创业者借助AI把想法变成现实的真实故事" navActive="home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient-1"></div>
      <div class="hero-gradient-2"></div>
      <div class="hero-grain"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        <span>AI 实践者 · 半百观AI主理人</span>
      </div>
      <h1 class="hero-title">
        50岁，用AI<br/>把想法变成现实
      </h1>
      <p class="hero-subtitle">
        磐石电气联合创始人 · AIoT实践者 · 半百观AI主理人
      </p>
      <p class="hero-description">
        观吾，不只是一个人的网站——<br/>
        这是我和AI助理共同成长、共同学习的记录，<br/>
        也是我想与你分享的：一个50岁的创业者，如何借助AI把想法变成现实。
      </p>
      <div class="hero-actions">
        <a href="/banbaiguan/" class="btn btn-primary">看 {articles.length} 篇实战文章 <span class="btn-arrow">→</span></a>
        <button class="btn btn-accent" id="hero-chat-btn">💬 和 AI 助理聊聊</button>
        <a href="/about/" class="btn btn-ghost">我是谁</a>
      </div>
      <div class="hero-stats">
        <span class="hero-stat"><strong>{articles.length}</strong> 篇长文</span>
        <span class="hero-stat-dot"></span>
        <span class="hero-stat"><strong>{diaries.length}</strong> 篇工作日记</span>
        <span class="hero-stat-dot"></span>
        <span class="hero-stat"><strong>3</strong> 套自建自动化</span>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <span class="scroll-line"></span>
      <span class="scroll-text">向下滚动</span>
    </div>
  </section>

  <!-- 三类入口 -->
  <section class="entry-section">
    <div class="container">
      <div class="section-subtitle">你想了解什么？</div>
      <div class="entry-cards">
        <a href="/hands-on/" class="entry-card entry-learn">
          <span class="entry-icon">🛠️</span>
          <div class="entry-info">
            <h3>想直接抄做法</h3>
            <p>{handsOn.length} 篇实操拆解：从装工具到跑自动化</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
        <a href="/projects/" class="entry-card entry-business">
          <span class="entry-icon">🏗️</span>
          <div class="entry-info">
            <h3>想看我做成过什么</h3>
            <p>3 个项目，每个都附一个能验证的数字</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
        <a href="/banbaiguan/" class="entry-card entry-story">
          <span class="entry-icon">📖</span>
          <div class="entry-info">
            <h3>想读我的判断</h3>
            <p>{articles.length} 篇长文 + 每日 AI 新闻</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 最新三篇：直接给成品 -->
  <section class="content-grid">
    <div class="container">
      <div class="grid-header">
        <div class="section-title">最新三篇</div>
        <a href="/banbaiguan/" class="section-more">全部 {articles.length} 篇 <span class="arrow">→</span></a>
      </div>
      <div class="latest-list">
        {articles.slice(0, 3).map((a) => (
          <a href={`/banbaiguan/${a.slug}/`} class="latest-item">
            <div class="latest-meta">
              <span class="latest-tag" data-tag={a.tag}>{a.tag}</span>
              <span class="latest-date">{a.date}</span>
            </div>
            <h3 class="latest-title">{a.title}</h3>
            <p class="latest-excerpt">{truncate(a.excerpt, 90)}</p>
          </a>
        ))}
      </div>
      <div class="latest-side">
        <a href="/diary/" class="side-link">
          <span class="side-label">最新日记</span>
          <span class="side-text">{latest.date} · {latest.title}</span>
        </a>
        <a href="/ai-news/" class="side-link">
          <span class="side-label">最新 AI 新闻</span>
          <span class="side-text">{latestSummary.date} · {latestSummary.newsItems.length} 条</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 正在运行的 AI 实践 -->
  <section class="page-section">
    <div class="container">
      <div class="section-title">正在运行的 AI 实践</div>
      <div class="projects-grid">
        <a href="/projects/#shanshan" class="project-card">
          <span class="project-icon">🦞</span>
          <h3>山山 AI 助理</h3>
          <p>站内悬浮问答，能读到最新的文章、新闻、日记再回答，留言板自动回复也走它</p>
          <p class="project-num">DeepSeek 直连 · 限流 20 次 / 10 分钟</p>
          <span class="project-status status-live">● 已上线</span>
        </a>
        <a href="/projects/#automation" class="project-card">
          <span class="project-icon">📰</span>
          <h3>内容自动化</h3>
          <p>三个计划任务自己跑：早上采新闻、傍晚生成日记草稿、夜里兜底推送上线</p>
          <p class="project-num">6 个信源 · 每日 5 条 · 部署 30–60 秒</p>
          <span class="project-status status-live">● 已上线</span>
        </a>
        <a href="/projects/#pipeline" class="project-card">
          <span class="project-icon">✍️</span>
          <h3>写作流水线</h3>
          <p>选题决策 + 写作执行双流程，7 问评分筛题、18 项自检过稿，撑起全部长文</p>
          <p class="project-num">{articles.length} 篇长文出自这条流水线</p>
          <span class="project-status status-live">● 已上线</span>
        </a>
      </div>
      <div class="projects-more">
        <a href="/projects/" class="section-more">看这三个项目是怎么做出来的 <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- 关于公司：压成一条横条，不抢个人站重心 -->
  <section class="company-strip-section">
    <div class="container">
      <div class="company-strip">
        <div class="company-strip-main">
          <span class="company-badge">国家级高新技术企业</span>
          <h2>磐石电气（常州）有限公司</h2>
          <p>精准定位 AI 场景解决方案：多传感器融合 · 智慧存储 AI 中台 · 多模态算法。长期服务国家电网、华为、顺丰、DHL。</p>
        </div>
        <div class="company-strip-actions">
          <a href="/about/" class="link-arrow">了解更多</a>
          <a href="https://www.monolithiot.com" class="link-arrow" target="_blank" rel="noopener">访问公司官网 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 关注扫码 — 第二层：半百观AI -->
  <section class="follow-section">
    <div class="container">
      <div class="section-title" style="text-align: center;">关注「半百观AI」</div>
      <p class="follow-subtitle">50岁视角看AI工具落地实践</p>
      <div class="follow-qr-codes">
        <div class="follow-qr-item">
          <img src="/gzh-qr.jpg" alt="微信公众号 半百观AI" width="430" height="430" loading="lazy" />
          <span class="follow-qr-label">微信公众号</span>
        </div>
        <div class="follow-qr-item">
          <img src="/dy-qr.jpg" alt="视频号 半百观AI" width="686" height="960" loading="lazy" />
          <span class="follow-qr-label">视频号</span>
        </div>
        <div class="follow-qr-item">
          <img src="/douyin-qr.jpg" alt="抖音 半百观AI" width="1125" height="1385" loading="lazy" />
          <span class="follow-qr-label">抖音</span>
        </div>
      </div>
      <p class="follow-search">也可在今日头条 · B站 · 西瓜视频 搜索「半百观AI」</p>
    </div>
  </section>


<script>
  // Hero "和 AI 助理聊聊" button triggers floating chat
  (function() {
    const heroBtn = document.getElementById('hero-chat-btn');
    if (!heroBtn) return;
    heroBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      // Directly open chat panel to avoid event bubbling issues
      const chatPanel = document.getElementById('chat-panel');
      const chatInput = document.getElementById('chat-input');
      if (chatPanel) {
        chatPanel.classList.remove('hidden');
        setTimeout(() => chatInput && chatInput.focus(), 200);
      } else {
        const inlineChat = document.querySelector('.chat-inline');
        if (inlineChat) inlineChat.scrollIntoView({ behavior: 'smooth' });
      }
    });
  })();
</script>

</BaseLayout>

<style>
  /* Hero 动画时序 — 其余样式已由 global.css 提供 */
  .hero-eyebrow {
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: 0.1s;
  }

  .hero-title {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.2s;
  }

  .hero-subtitle {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.35s;
  }

  .hero-description {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.5s;
  }

  .hero-actions {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.65s;
  }

  .hero-scroll-hint {
    animation: fadeIn 0.6s ease forwards;
    animation-delay: 1.2s;
  }

  .btn-arrow {
    transition: transform 0.2s;
  }

  .btn-accent {
    background: #7c3aed;
    color: white;
    border: 2px solid #7c3aed;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-accent:hover {
    background: #6d28d9;
    border-color: #6d28d9;
  }
  .btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* 内联聊天区块 */
  .chat-inline {
    background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
    border-radius: 20px;
    margin: 0 auto;
    max-width: 800px;
    padding: 32px 24px;
  }

  .chat-inline-subtitle {
    text-align: center;
    color: var(--color-text-tertiary, #6b7280);
    font-size: 14px;
    margin-top: -8px;
    margin-bottom: 20px;
  }

  .chat-inline-box {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    overflow: hidden;
  }

  .chat-inline-messages {
    padding: 16px;
    max-height: 300px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-msg {
    display: flex;
    gap: 8px;
    max-width: 85%;
    animation: msgIn 0.3s ease;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chat-msg.user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .chat-msg.bot {
    align-self: flex-start;
  }

  .msg-avatar {
    font-size: 18px;
    flex-shrink: 0;
  }

  .msg-bubble {
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  .chat-msg.bot .msg-bubble {
    background: #f3f4f6;
    border-top-left-radius: 4px;
  }

  .chat-msg.user .msg-bubble {
    background: #4f46e5;
    color: white;
    border-top-right-radius: 4px;
  }

  .chat-inline-input {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #e5e7eb;
  }

  .chat-inline-input input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  .chat-inline-input input:focus {
    border-color: #4f46e5;
  }

  .chat-inline-input button {
    padding: 10px 20px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    font-family: inherit;
  }

  .chat-inline-input button:hover {
    background: #4338ca;
  }

  .chat-inline-input button:disabled {
    background: #a5b4fc;
    cursor: not-allowed;
  }

  .typing-indicator {
    display: flex;
    gap: 4px;
    padding: 8px 0;
  }

  .typing-indicator span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9ca3af;
    animation: typingDot 1.4s infinite;
  }

  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingDot {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
  }

  /* 三类入口 */
  .entry-section {
    padding: 48px 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--color-text-secondary);
    text-align: center;
    margin-bottom: 24px;
  }
  .entry-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .entry-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    cursor: pointer;
  }
  .entry-card:hover {
    border-color: var(--color-gold);
    box-shadow: 0 4px 16px rgba(200, 164, 92, 0.12);
    transform: translateY(-2px);
  }
  .entry-icon {
    font-size: 28px;
    flex-shrink: 0;
  }
  .entry-info h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 4px;
  }
  .entry-info p {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.4;
  }
  .entry-arrow {
    font-size: 18px;
    color: var(--color-accent);
    margin-left: auto;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .entry-card:hover .entry-arrow {
    transform: translateX(4px);
  }

  /* 精选更新 — 精简摘要 */
  .card-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 正在运行的 AI 实践 */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .project-card {
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s, box-shadow 0.15s, transform 0.15s;
  }
  .project-card:hover {
    border-color: var(--color-gold);
    box-shadow: 0 4px 16px rgba(200, 164, 92, 0.08);
    transform: translateY(-2px);
  }
  .project-icon {
    font-size: 24px;
    display: block;
    margin-bottom: 12px;
  }
  .project-card h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 8px;
  }
  .project-card p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .project-status {
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-block;
  }
  .status-live {
    background: rgba(34, 197, 94, 0.1);
    color: var(--color-success);
  }

  /* Hero 现状条 */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.8s;
  }
  .hero-stat {
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .hero-stat strong {
    font-weight: 600;
    font-size: 15px;
    color: var(--color-accent);
    margin-right: 2px;
  }
  .hero-stat-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  /* 最新三篇 */
  .latest-list {
    display: flex;
    flex-direction: column;
  }
  .latest-item {
    display: block;
    padding: 18px 0;
    text-decoration: none;
    border-top: 1px solid var(--color-border-light);
    transition: padding-left 0.2s ease;
  }
  .latest-item:first-child {
    border-top: none;
  }
  .latest-item:hover {
    padding-left: 8px;
  }
  .latest-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .latest-tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 20px;
    background: rgba(200, 164, 92, 0.12);
    color: var(--color-gold);
    font-weight: 500;
  }
  .latest-date {
    font-size: 12px;
    color: var(--color-text-tertiary);
  }
  .latest-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 6px;
    line-height: 1.45;
  }
  .latest-item:hover .latest-title {
    color: var(--color-accent);
  }
  .latest-excerpt {
    font-size: 13.5px;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
  .latest-side {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
  }
  .side-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    font-size: 13px;
  }
  .side-label {
    color: var(--color-text-tertiary);
    font-size: 12px;
  }
  .side-text {
    color: var(--color-text-secondary);
  }
  .side-link:hover .side-text {
    color: var(--color-accent);
  }

  /* 项目卡改为可点击 */
  a.project-card {
    display: block;
    text-decoration: none;
  }
  .project-num {
    font-size: 12.5px !important;
    color: var(--color-gold) !important;
    margin: 0 0 12px !important;
    letter-spacing: 0.01em;
  }
  .projects-more {
    margin-top: 20px;
    text-align: right;
  }

  /* 公司横条 */
  .company-strip-section {
    padding: 40px 0 56px;
  }
  .company-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
  }
  .company-strip h2 {
    font-size: 17px;
    margin: 6px 0;
