---
import BaseLayout from '../../../layouts/Base.astro';
---

<BaseLayout title="调查管理后台" lang="zh">
  <div id="admin-app"></div>
</BaseLayout>

<style>
  .admin-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  .admin-login {
    max-width: 400px;
    margin: 80px auto 0;
    text-align: center;
  }
  .admin-login h2 {
    font-family: var(--font-serif);
    font-size: 24px;
    margin-bottom: 24px;
  }
  .admin-login input {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    font-size: 15px;
    margin-bottom: 16px;
    background: var(--color-surface);
    color: var(--color-text);
    box-sizing: border-box;
  }
  .admin-login input:focus { outline: none; border-color: var(--color-accent); }
  .admin-login .error-msg {
    color: var(--color-danger);
    font-size: 13px;
    margin-bottom: 12px;
    display: none;
  }
  .admin-login .error-msg.show { display: block; }
  /* Tabs */
  .admin-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--color-border-light);
    padding-bottom: 0;
  }
  .admin-tab {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    border: none;
    background: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s;
  }
  .admin-tab:hover { color: var(--color-accent); }
  .admin-tab.active { color: var(--color-accent); border-bottom-color: var(--color-accent); font-weight: 600; }
  /* Stats cards */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }
  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-serif);
  }
  .stat-label {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-top: 4px;
  }
  /* Charts area */
  .chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }
  .chart-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    padding: 20px;
  }
  .chart-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  /* Bar chart */
  .bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 13px;
  }
  .bar-label {
    width: 80px;
    text-align: right;
    color: var(--color-text-secondary);
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bar-track {
    flex: 1;
    height: 22px;
    background: var(--color-bg-alt);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.4s ease;
    min-width: 2px;
  }
  .bar-fill-a { background: var(--color-accent); }
  .bar-fill-b { background: var(--color-gold); }
  .bar-fill-p { background: var(--color-accent-light); }
  .bar-count {
    width: 40px;
    font-size: 12px;
    color: var(--color-text-secondary);
  }
  /* Table */
  .admin-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .admin-table th {
    background: var(--color-bg-alt);
    padding: 10px 12px;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
    border-bottom: 2px solid var(--color-border-light);
  }
  .admin-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border-light);
    vertical-align: top;
  }
  .admin-table tr:hover td { background: rgba(45,53,97,0.02); }
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
  }
  .badge-a { background: rgba(45,53,97,0.1); color: var(--color-accent); }
  .badge-b { background: rgba(200,164,92,0.15); color: #8b6914; }
  .badge-pass { background: rgba(34,197,94,0.1); color: #15803d; }
  .badge-fail { background: rgba(239,68,68,0.1); color: #dc2626; }
  /* Buttons */
  .admin-btn {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .admin-btn-primary { background: var(--color-accent); color: #fff; }
  .admin-btn-primary:hover { background: var(--color-accent-hover); }
  .admin-btn-ghost { background: transparent; border: 1.5px solid var(--color-border); color: var(--color-text-secondary); }
  .admin-btn-ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }
  /* Loading */
  .admin-loading {
    text-align: center;
    padding: 40px;
    color: var(--color-text-tertiary);
    font-size: 14px;
  }
  .open-text-cell {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }
  .open-text-cell:hover { white-space: normal; }
  /* Pagination */
  .admin-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 14px;
  }
  .admin-pagination button {
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .admin-pagination button:hover { border-color: var(--color-accent); }
  .admin-pagination .current { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .chart-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .stat-value { font-size: 24px; }
  }
</style>

<script>
const adminApp = document.getElementById('admin-app');
let token = localStorage.getItem('survey_token') || '';
let currentTab = 'stats';
let statsData = null;
let responsesPage = 1;

function render() {
  if (token) {
    renderDashboard();
    loadStats();
  } else {
    renderLogin();
  }
}

function renderLogin() {
  adminApp.innerHTML = `
    <div class="admin-wrapper">
      <div class="admin-login">
        <h2>📊 调查管理后台</h2>
        <input type="password" id="login-pwd" placeholder="请输入管理密码" autocomplete="current-password">
        <div class="error-msg" id="login-error">密码错误，请重试</div>
        <button class="admin-btn admin-btn-primary" id="login-btn" style="width:100%">登录</button>
      </div>
    </div>
  `;
  document.getElementById('login-pwd').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') doLogin();
  });
  document.getElementById('login-btn').onclick = doLogin;
}

async function doLogin() {
  const pwd = document.getElementById('login-pwd').value.trim();
  if (!pwd) return;
  const btn = document.getElementById('login-btn');
  btn.disabled = true; btn.textContent = '登录中...';
  try {
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pwd }),
    });
    const data = await res.json();
    if (data.success) {
      token = data.token;
      localStorage.setItem('survey_token', token);
      renderDashboard();
      loadStats();
    } else {
      document.getElementById('login-error').classList.add('show');
    }
  } catch {
    document.getElementById('login-error').textContent = '网络错误，请重试';
    document.getElementById('login-error').classList.add('show');
  }
  btn.disabled = false; btn.textContent = '登录';
}

function renderDashboard() {
  adminApp.innerHTML = `
    <div class="admin-wrapper">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h2 style="font-family:var(--font-serif);font-size:22px;">📊 调查管理后台</h2>
        <div style="display:flex;gap:8px;">
          <button class="admin-btn admin-btn-ghost" id="export-btn">📥 导出CSV</button>
          <button class="admin-btn admin-btn-ghost" id="logout-btn">退出</button>
        </div>
      </div>
      <div class="admin-tabs">
        <button class="admin-tab ${currentTab==='stats'?'active':''}" data-tab="stats">数据概览</button>
        <button class="admin-tab ${currentTab==='responses'?'active':''}" data-tab="responses">详细记录</button>
      </div>
      <div id="tab-content">
        <div class="admin-loading">加载中...</div>
      </div>
    </div>
  `;
  document.querySelectorAll('.admin-tab').forEach(tab => {
    tab.onclick = () => {
      currentTab = tab.dataset.tab;
      document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      if (currentTab === 'stats') renderStats();
      else renderResponses();
    };
  });
  document.getElementById('logout-btn').onclick = () => {
    localStorage.removeItem('survey_token');
    token = '';
    render();
  };
  document.getElementById('export-btn').onclick = doExport;
}

function headers() {
  return { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' };
}

async function loadStats() {
  try {
    const res = await fetch('/api/admin/stats', { headers: headers() });
    if (res.status === 401) { localStorage.removeItem('survey_token'); token = ''; render(); return; }
    statsData = await res.json();
    renderStats();
    if (currentTab === 'responses') renderResponses();
  } catch (err) {
    console.error('Load stats error:', err);
  }
}

function renderStats() {
  if (!statsData) return;
  const d = statsData;
  const tc = document.getElementById('tab-content');

  // Build decision chart
  const questionNos = [1,3,5,6,8,9,13,14,16,17,18,21,22];
  const decByQ = {};
  for (const q of questionNos) decByQ[q] = { A: 0, B: 0 };
  for (const item of d.decisions) {
    if (decByQ[item.question_no] !== undefined) {
      decByQ[item.question_no][item.choice] = item.cnt || item.count || 0;
    }
  }

  let decBarsHTML = '';
  for (const q of questionNos) {
    const total = decByQ[q].A + decByQ[q].B || 1;
    const pctA = Math.round(decByQ[q].A / total * 100);
    const pctB = Math.round(decByQ[q].B / total * 100);
    decBarsHTML += `
      <div style="margin-bottom:12px;">
        <div style="font-size:12px;font-weight:600;margin-bottom:4px;">Q${q}</div>
        <div class="bar-row">
          <span style="width:20px;font-size:12px;color:var(--color-accent);">A</span>
          <div class="bar-track"><div class="bar-fill bar-fill-a" style="width:${pctA}%"></div></div>
          <span class="bar-count">${pctA}%</span>
        </div>
        <div class="bar-row">
          <span style="width:20px;font-size:12px;color:var(--color-gold);">B</span>
          <div class="bar-track"><div class="bar-fill bar-fill-b" style="width:${pctB}%"></div></div>
          <span class="bar-count">${pctB}%</span>
        </div>
      </div>`;
  }

  // Demographics
  const demoG = d.demographics.gender || [];
  const demoA = d.demographics.age || [];
  const demoE = d.demographics.education || [];
  const demoC = d.demographics.hasChild || [];

  const genderLabels = ['男', '女', '其他/不愿透露'];
  const ageLabels = ['25岁以下', '25-30岁', '31-35岁', '36-40岁', '41-45岁', '46岁以上'];
  const eduLabels = ['高中及以下', '大专', '本科', '硕士', '博士及以上'];
  const childLabels = ['有孩子', '无孩子'];

  function getDemoLabel(item, excludeKeys, fallback) {
    var keys = Object.keys(item);
    for (var k = 0; k < keys.length; k++) {
      if (keys[k] !== 'cnt' && excludeKeys.indexOf(keys[k]) === -1) return item[keys[k]];
    }
    return fallback || '';
  }

  function demoBars(items, labels) {
    var total = items.reduce(function(s, i) { return s + (i.cnt || 0); }, 0) || 1;
    return items.map(function(item, idx) {
      var pct = Math.round((item.cnt || 0) / total * 100);
      var excludeKeys = ['gender', 'age_group', 'education', 'has_child'];
      var labelValue = getDemoLabel(item, excludeKeys, labels[idx] || '');
      return '<div class="bar-row">' +
        '<span class="bar-label">' + labelValue + '</span>' +
        '<div class="bar-track"><div class="bar-fill bar-fill-p" style="width:' + pct + '%"></div></div>' +
        '<span class="bar-count">' + pct + '%</span>' +
      '</div>';
    }).join('');
  }

  // PANAS averages
  const panasItems = ['interested','enthusiastic','proud','inspired','determined','distressed','nervous','afraid','guilty','hostile'];
  const panasLabels = ['感兴趣的','热情的','自豪的','备受鼓舞的','意志坚决的','心烦的','紧张的','害怕的','内疚的','敌意的'];
  const panasMap = {};
  for (const p of d.panas) panasMap[p.item] = p.avg_score;
  let panasHTML = '';
  panasItems.forEach((item, i) => {
    const avg = (panasMap[item] || 0).toFixed(1);
    const pct = Math.round(avg / 5 * 100);
    panasHTML += `<div class="bar-row">
      <span class="bar-label">${panasLabels[i]}</span>
      <div class="bar-track"><div class="bar-fill bar-fill-p" style="width:${pct}%"></div></div>
      <span class="bar-count">${avg}</span>
    </div>`;
  });

  // Lang distribution
  const langDist = (d.langDistribution || []);
  const langHTML = langDist.map(l => `<span style="margin-right:16px;font-size:13px;">${l.lang === 'zh' ? '中文' : 'English'}: <strong>${l.cnt}</strong></span>`).join('');

  tc.innerHTML = `
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value">${d.total}</div>
        <div class="stat-label">总提交数</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">${d.avgDuration}s</div>
        <div class="stat-label">平均用时</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">${d.mathPassRate}%</div>
        <div class="stat-label">数学题通过率</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" style="font-size:16px;padding-top:8px;">${langHTML}</div>
        <div class="stat-label">语言分布</div>
      </div>
    </div>
    <div class="chart-grid">
      <div class="chart-card">
        <div class="chart-title">情景题 A/B 选择分布</div>
        ${decBarsHTML}
      </div>
      <div class="chart-card">
        <div class="chart-title">PANAS 情绪量表均值</div>
        ${panasHTML}
        <div style="margin-top:20px;">
          <div class="chart-title">人口统计</div>
          <div style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">性别</div>
          ${demoBars(demoG, genderLabels)}
          <div style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin:12px 0 6px;">年龄</div>
          ${demoBars(demoA, ageLabels)}
          <div style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin:12px 0 6px;">学历</div>
          ${demoBars(demoE, eduLabels)}
          <div style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin:12px 0 6px;">是否有孩子</div>
          ${demoBars(demoC, childLabels)}
        </div>
      </div>
    </div>
  `;
}

async function renderResponses() {
  const tc = document.getElementById('tab-content');
  tc.innerHTML = '<div class="admin-loading">加载中...</div>';
  try {
    const res = await fetch(`/api/admin/responses?page=${responsesPage}&pageSize=20`, { headers: headers() });
    if (res.status === 401) { localStorage.removeItem('survey_token'); token = ''; render(); return; }
    const data = await res.json();
    const responses = data.responses || [];
    const decMap = {};
    const panasMap = {};
    for (const d of (data.decisions || [])) {
      if (!decMap[d.response_id]) decMap[d.response_id] = [];
      decMap[d.response_id].push(d);
    }
    for (const p of (data.panas || [])) {
      if (!panasMap[p.response_id]) panasMap[p.response_id] = [];
      panasMap[p.response_id].push(p);
    }
    const pagination = data.pagination || {};

    let html = '<div class="admin-table-wrap"><table class="admin-table"><thead><tr>';
    html += '<th>ID</th><th>时间</th><th>语言</th><th>用时</th><th>数学</th><th>性别</th><th>年龄</th><th>学历</th>';
    html += '<th>选择倾向</th><th>开放回答</th>';
    html += '</tr></thead><tbody>';

    for (const r of responses) {
      const decs = decMap[r.id] || [];
      const aCount = decs.filter(d => d.choice === 'A').length;
      const bCount = decs.filter(d => d.choice === 'B').length;
      const mathPass = r.math_answer === 83;

      html += `<tr>`;
      html += `<td>${r.id}</td>`;
      html += `<td style="white-space:nowrap;">${r.created_at ? new Date(r.created_at).toLocaleString('zh-CN') : '-'}</td>`;
      html += `<td>${r.lang === 'zh' ? '中' : 'EN'}</td>`;
      html += `<td>${r.duration_sec || '-'}s</td>`;
      html += `<td><span class="badge ${mathPass ? 'badge-pass' : 'badge-fail'}">${mathPass ? '✓' : '✗'}</span></td>`;
      html += `<td>${r.gender || '-'}</td>`;
      html += `<td>${r.age_group || '-'}</td>`;
      html += `<td>${r.education || '-'}</td>`;
      html += `<td><span class="badge badge-a">A×${aCount}</span> <span class="badge badge-b">B×${bCount}</span></td>`;
      const ot = (r.open_text || '').substring(0, 50);
      html += `<td class="open-text-cell" title="${(r.open_text || '').replace(/"/g, '&quot;')}">${ot || '-'}</td>`;
      html += '</tr>';
    }

    html += '</tbody></table></div>';

    // Pagination
    if (pagination.totalPages > 1) {
      html += '<div class="admin-pagination">';
      for (let i = 1; i <= pagination.totalPages; i++) {
        html += `<button class="${i === responsesPage ? 'current' : ''}" data-page="${i}">${i}</button>`;
      }
      html += '</div>';
    }

    tc.innerHTML = html;

    // Bind pagination
    tc.querySelectorAll('.admin-pagination button').forEach(btn => {
      btn.onclick = () => {
        responsesPage = parseInt(btn.dataset.page);
        renderResponses();
      };
    });
  } catch (err) {
    tc.innerHTML = '<div class="admin-loading">加载失败</div>';
    console.error('Render responses error:', err);
  }
}

async function doExport() {
  try {
    const res = await fetch('/api/admin/export', { headers: headers() });
    if (res.status === 401) { localStorage.removeItem('survey_token'); token = ''; render(); return; }
    if (!res.ok) throw new Error('Export failed');
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `survey-export-${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  } catch (err) {
    alert('导出失败，请重试');
    console.error(err);
  }
}

render();
</script>
