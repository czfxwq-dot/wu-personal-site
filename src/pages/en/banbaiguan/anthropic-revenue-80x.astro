<BaseLayout title="Anthropic's Annual Revenue Surges 80x — BanbaiGuan AI" jsonLd={articleJsonLd} ogDescription="The rapid growth of Anthropic and what it means for the AI industry landscape." navActive="banbaiguan" lang="en">
  <article class="article-page">
