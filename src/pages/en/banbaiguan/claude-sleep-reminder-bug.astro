---
import BaseLayout from '../../../layouts/Base.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Article: Claude Sleep Reminder Bug",
  "datePublished": "2026-01-01",
  "dateModified": "2026-01-01",
  "description": "English version of: Article: Claude Sleep Reminder Bug",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  },
  "publisher": {
    "@type": "Organization",
    "name": "BanbaiGuan AI",
    "url": "https://ban-bai.com"
  },
  "url": "https://ban-bai.com/en/banbaiguan/claude-sleep-reminder-bug/"
