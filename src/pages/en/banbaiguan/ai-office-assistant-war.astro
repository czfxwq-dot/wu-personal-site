<BaseLayout title="AI Office Assistant War: Tencent, ByteDance, and Alibaba Launch AI Assistants Simultaneously — BanbaiGuan AI" jsonLd={articleJsonLd} ogDescription="The battle for AI office assistants heats up as major tech companies launch competing products." navActive="banbaiguan" lang="en">
