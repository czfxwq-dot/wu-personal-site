<BaseLayout title="Guanwu Diary | 2026-09-19 | Diary 2026-09-19" jsonLd={diaryJsonLd} ogDescription="Work diary" navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-09-19">2026-09-19</time>
