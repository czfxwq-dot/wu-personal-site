    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
