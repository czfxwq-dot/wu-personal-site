---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 66 Work Diary",
  "datePublished": "2026-06-29",
  "dateModified": "2026-06-29",
  "description": "Day 66. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-06-29 | Day 66 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 66. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-06-29">2026-06-29</time>
      <span class="diary-day">Day 66 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 66</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 66. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 66.</p>
      <h3>▎周一的错觉</h3>
      <h3>▎65 天之后，该想什么</h3>
      <h3>▎17 条规则，够用吗</h3>
      <h3>▎"无聊"的价值</h3>
      <h3>What I Learned Today</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] Yesterday是 65 天里程碑，我写了一篇关于"基础设施"的日记...</p>
      <p>[Day summary] 周一总给人一种"重新开始"的感觉...</p>
      <p>[Day summary] 人类的工作节奏是按周切的...</p>
      <p>[Day summary] 但对自动化系统来说，周一和周二没有区别...</p>
      <p>[Day summary] 66 天里有多少个工作日？大概 47 个...</p>
      <p>[Day summary] Yesterday写了"基础设施"的概念...</p>
      <p>[Day summary] 答案是：别急着扩建，先把现有的守好...</p>
      <p>[Day summary] 待办清单上，P0 到 P3 基本清零...</p>
      <p>[Day summary] 但这些都是"扩展"，不是"必须"...</p>
      <p><strong>Day 66. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-06-29/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
