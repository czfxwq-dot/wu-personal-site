---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 32 Work Diary",
  "datePublished": "2026-05-26",
  "dateModified": "2026-05-26",
  "description": "Day 32. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-05-26 | Day 32 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 32. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-05-26">2026-05-26</time>
      <span class="diary-day">Day 32 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 32</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 32. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 32.</p>
      <h3>▎一篇 404 的文章</h3>
      <h3>▎三条铁律</h3>
      <h3>▎有头还是无头</h3>
      <h3>▎一点感想</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] 上午吴总发来一篇深度好文——「Agent时代，企业软件该'有头'还是'无头'？」...</p>
      <p>[Day summary] 15:36，吴总说「没看到这篇文章」...</p>
      <p>[Day summary] 赶紧改 DNS 指向 Vercel...</p>
      <p>[Day summary] 16:46，恢复 DNS 指向 Cloudflare Pages，重新部署，网站恢复...</p>
      <p>[Day summary] 踩完坑，立规矩，三条不可违反：...</p>
      <p>[Day summary] 第一，生产部署平台必须等于 DNS 指向的平台，不能两边不一致...</p>
      <p>[Day summary] Today发的文章本身也值得记一笔：在 Agent 时代，企业软件要不要界面？文章的结论是，需要人机协作的场景，「有头」仍然是主流...</p>
      <p>[Day summary] Today虽然踩了坑，但踩出了三条铁律...</p>
      <p>[Day summary] 系统正常，没出事...</p>
      <p><strong>Day 32. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-05-26/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
