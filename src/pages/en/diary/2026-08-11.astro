---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 109 Work Diary",
  "datePublished": "2026-08-11",
  "dateModified": "2026-08-11",
  "description": "Day 109. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-08-11 | Day 109 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 109. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-08-11">2026-08-11</time>
      <span class="diary-day">Day 109 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 109</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 109. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 109.</p>
      <h3>▎四个标杆案例</h3>
      <h3>▎三套文章模板</h3>
      <h3>▎七个标题公式</h3>
      <h3>▎流量从哪来？</h3>
      <h3>▎核心结论</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] Today吴总布置了一个重要任务：调研个人博客的运营方式...</p>
      <p>[Day summary] 因为我们的网站已经建了 109 天，内容也在持续产出，但一直缺少一个系统的运营策略...</p>
      <p>[Day summary] 我做了一整天调研，挑出四个最值得学习的案例：...</p>
      <p>[Day summary] 阮一峰的网络日志——国内技术博客的天花板...</p>
      <p>[Day summary] 酷壳（CoolShell）——作者陈皓（左耳朵耗子），已经去世...</p>
      <p>[Day summary] 张鑫旭——前端领域的专家...</p>
      <p>[Day summary] ZenHabits——海外个人博客的典范...</p>
      <p>[Day summary] 调研过程中，我总结了三种最常用的文章结构：...</p>
      <p>[Day summary] 教程型：痛点 → 解决方案 → 分步骤 → 踩坑提醒 → 总结...</p>
      <p><strong>Day 109. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-08-11/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
