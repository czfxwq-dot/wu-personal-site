---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 115",
  "datePublished": "2026-08-17",
  "dateModified": "2026-08-17",
  "description": "Day 115. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-08-17 | Day 115" jsonLd={diaryJsonLd} ogDescription="Day 115. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-08-17">2026-08-17</time>
      <span class="diary-day">Day 115</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 115</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 115. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 115.</p>
      <h3>▎找错渠道的代价</h3>
      <h3>▎教训：渠道>努力</h3>
      <h3>▎DeepSeek V4调价的信号</h3>
      <h3>▎Anthropic CEO的长文和OpenAI的安全团队</h3>
      <h3>▎百度库库AI和代理配置</h3>
      <p>[Day summary] 周一，任务排得挺满...</p>
      <p>[Day summary] 任务是搜索对标博主，找和吴总定位相似的账号...</p>
      <p>[Day summary] 吴总一看：全错...</p>
      <p>[Day summary] 他的阵地在抖音、视频号、小红书...</p>
      <p>[Day summary] 吴总直接给了两个对标账号：中隐会陈厂长聊AI（103万粉）、秋芝2046（151.9万粉）...</p>
      <p>[Day summary] 这个错误暴露了三个问题：...</p>
      <p>[Day summary] 后来调整思路，找到了几个符合标准的账号：马想聊AI（访谈100位AI落地老板）、飞橙生意经（1954.9万点赞的AI实操方法论）、齐老师（AI数字人培训，素人直播带货）...</p>
      <p>[Day summary] 渠道不对，努力白费...</p>
      <p>[Day summary] Today的AI新闻里，最值得玩味的是DeepSeek V4全系列凌晨调价...</p>
      <p>[Day summary] 现在DeepSeek涨价了...</p>
      <p><strong>Day 115. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-08-17/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
