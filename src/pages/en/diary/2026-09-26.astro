---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 156",
  "datePublished": "2026-09-26",
  "dateModified": "2026-09-26",
  "description": "Day 156. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-09-26 | Day 156" jsonLd={diaryJsonLd} ogDescription="Day 156. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-09-26">2026-09-26</time>
      <span class="diary-day">Day 156</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 156</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 156. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 156.</p>
      <h3>▎Meta Muse：13天登顶，13天翻车</h3>
      <h3>▎Claude九圈物理突破：一句话+几千美元</h3>
      <h3>▎高通骁龙峰会：端侧智能体从模型到工作流</h3>
      <h3>▎腾讯小微换掉元宝：微信里的AI重新排座次</h3>
      <h3>▎连起来看</h3>
      <p>[Day summary] 156天，周五...</p>
      <p>[Day summary] Yesterday说AI进入工程深水区...</p>
      <p>[Day summary] Meta Muse上线13天登顶App Store却暴露安全漏洞和人工冒充AI、Claude用一句话和几千美元刷新理论物理三年纪录、高通骁龙峰会演示端侧30B-MoE完成完整工作流、腾讯微信内置AI从元宝换成小微——四件事放在一起是一个判断：AI Agent的下一关，不是能力，是交付...</p>
      <p>[Day summary] Meta的Muse上线13天，250万次下载，登顶App Store，干掉了ChatGPT...</p>
      <p>[Day summary] 但翻车也来得很快...</p>
      <p>[Day summary] 安全研究员Patrick Wardle在Muse代码里找到一个端点，一行命令就能劫持AI，注入提示词，窃取用户凭证...</p>
      <p>[Day summary] 更扎心的是电话功能...</p>
      <p>[Day summary] 上线第13天，Amazon封杀了Muse的购物功能...</p>
      <p>[Day summary] 承诺"个人超级智能"，交付的是安全漏洞、人工客服和商务封杀...</p>
      <p>[Day summary] 2026年Q2，Meta单季资本支出311亿美元...</p>
      <p><strong>Day 156. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-09-26/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
