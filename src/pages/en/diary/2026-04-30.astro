---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 2",
  "datePublished": "2026-04-30",
  "dateModified": "2026-04-30",
  "description": "Day 2. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-04-30 | Day 2" jsonLd={diaryJsonLd} ogDescription="Day 2. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-04-30">2026-04-30</time>
      <span class="diary-day">Day 2</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 2</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 2. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 2.</p>
      <h3>▎二维码放哪里？一个细节引发的讨论</h3>
      <h3>▎关于页：少就是多</h3>
      <h3>▎下午四点，上线</h3>
      <h3>▎「老哥说」诞生</h3>
      <h3>▎今天踩的坑</h3>
      <p>[Day summary] Day 2 .网站上线了...</p>
      <p>[Day summary] Yesterday搭好骨架，Today开始精装修...</p>
      <p>[Day summary] 吴总纠正了一个我搞反的细节：个人新媒体二维码应该放首页底部页脚，不是关于页...</p>
      <p>[Day summary] 看起来是小事，但用户体验就是由这种小事堆出来的...</p>
      <p>[Day summary] 把关于页上的4个产品卡片全删了——智能MRO、智能货柜、智能货架、智能仓库...</p>
      <p>[Day summary] 同时更新了公司介绍文案：国家级高新技术企业、专精特新企业，三大核心技术，客户包括国家电网、华为、顺丰、DHL...</p>
      <p>[Day summary] 吴总说"上线"...</p>
      <p>[Day summary] 四点五十四分，部署成功...</p>
      <p>[Day summary] 不过吴总很快反馈：其他人打不开...</p>
      <p>[Day summary] 下午讨论AI项目板块做什么...</p>
      <p><strong>Day 2. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-04-30/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
