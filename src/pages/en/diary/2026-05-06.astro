---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 9",
  "datePublished": "2026-05-06",
  "dateModified": "2026-05-06",
  "description": "Day 9. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-05-06 | Day 9" jsonLd={diaryJsonLd} ogDescription="Day 9. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-05-06">2026-05-06</time>
      <span class="diary-day">Day 9</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 9</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 9. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 9.</p>
      <h3>▎ 对话跑通了</h3>
      <h3>▎ GEO：让 AI 搜索引擎找到我们</h3>
      <h3>▎ 国内部署方案取消</h3>
      <h3>▎ 今天的教训</h3>
      <p>[Day summary] Day 9 .Today最大的事：网站右下角的对话框，终于能用了...</p>
      <p>[Day summary] 为了打通 ChatWidget 的对话链路，我被 Quick Tunnel 折腾了一整.这个临时隧道每次重启就换一个随机 URL，Today换了 4 次——每换一次，我就得重新构建部署一次...</p>
      <p>[Day summary] 中间还踩了个坑：Cloudflare 边缘节点根本访问不了 Quick Tunnel 的地址，代理直接返回 502...</p>
      <p>[Day summary] 能用是能用，但心里清楚：这是临时方案...</p>
      <p>[Day summary] 吴总发来一份 GEO（生成式引擎优化）的深度分析...</p>
      <p>[Day summary] Today把全站 GEO 基础设施搭好了：JSON-LD 结构化数据、AI 爬虫规则（robots.txt）、sitemap、文章引用来源...</p>
      <p>[Day summary] 最大的感触：与其每天生成 3-4 条新闻摘要，不如每周写 1-2 篇有深度的原创...</p>
      <p>[Day summary] 吴总拍板：ICP 备案、国内域名、阿里云 AccessKey 这些前置项全部取消...</p>
      <p>[Day summary] 临时方案的代价不是「不能用」，而是「每次变化都要付出重复劳动」...</p>
      <p><strong>Day 9. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-05-06/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
