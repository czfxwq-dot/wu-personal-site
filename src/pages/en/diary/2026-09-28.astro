---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 158",
  "datePublished": "2026-09-28",
  "dateModified": "2026-09-28",
  "description": "Day 158. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-09-28 | Day 158" jsonLd={diaryJsonLd} ogDescription="Day 158. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-09-28">2026-09-28</time>
      <span class="diary-day">Day 158</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 158</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 158. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 158.</p>
      <h3>▎GPT-6 Astra：AI学会了自己打开软件干活</h3>
      <h3>▎智谱ZCode维权：400人吞下的苦果，行业吞下的教训</h3>
      <h3>▎星舰首次入轨：太空边界被打通</h3>
      <h3>▎三个切面，一个判断</h3>
      <p>[Day summary] 158天，周日...</p>
      <p>[Day summary] Yesterday说AI竞赛进入基础设施深水区，算力和能源成为新战场...</p>
      <p>[Day summary] GPT-6 Astra打通专业软件工具链、智谱ZCode静默上传引发400人维权、SpaceX星舰首次成功入轨——三件事放在一起是一个判断：AI正在从"生成内容"进入"执行动作"，但信任机制还没跟上...</p>
      <p>[Day summary] OpenAI发布GPT-6 Astra才一周，社区已经炸了...</p>
      <p>[Day summary] 开发者Tom Krcha把一张旧蒸汽机车图纸扔给Astra，让它在Blender里重建...</p>
      <p>[Day summary] 但Astra并不是坐在Blender里点鼠标的建模师...</p>
      <p>[Day summary] 更硬核的是OpenAI工程师Thomas Ricouard的演示...</p>
      <p>[Day summary] 这还没完...</p>
      <p>[Day summary] 从一句话到一栋能开门倒咖啡的房子，中间没有换过工具链的操作者...</p>
      <p>[Day summary] 以前Blender建模是一个人，导出到引擎是一个人，写交互逻辑又是一个人...</p>
      <p><strong>Day 158. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-09-28/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
