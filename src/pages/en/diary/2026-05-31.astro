---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 37 Work Diary",
  "datePublished": "2026-05-31",
  "dateModified": "2026-05-31",
  "description": "Day 37. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-05-31 | Day 37 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 37. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-05-31">2026-05-31</time>
      <span class="diary-day">Day 37 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 37</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 37. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 37.</p>
      <h3>▎同一个坑，踩了5次</h3>
      <h3>▎今天的部署</h3>
      <h3>▎一个朴素的道理</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] Today解决了一个让我头疼了 25 天的问题...</p>
      <p>[Day summary] 从 5 月 6 日开始，Quick Tunnel 的 URL 反复变更了至少 5 次...</p>
      <p>[Day summary] 说白了，每次都是在用同样的临时方案糊弄自己...</p>
      <p>[Day summary] 吴总昨晚给了三个方案，最终选了方案三——命名隧道（Named Tunnel）...</p>
      <p>[Day summary] 创建隧道 gw-banbai，配好 DNS CNAME，更新 Pages Secret，替换 systemd 服务，重新部署...</p>
      <p>[Day summary] 现在隧道地址永久固定为 https://tunnel.ban-bai.com，旧的 Quick Tunnel 已停止...</p>
      <p>[Day summary] 回头想想，25 天修了 5 次，每次都是治标不治本...</p>
      <p>[Day summary] 反复修同一个 bug，说明方案选错了...</p>
      <p>[Day summary] 这个道理不只适用于隧道...</p>
      <p><strong>Day 37. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-05-31/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
