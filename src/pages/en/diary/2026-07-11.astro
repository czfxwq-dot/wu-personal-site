    margin: 0;
    font-size: 0.875rem;
    color: #92400e;
  }
  .original-content {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .original-content h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    color: var(--text-secondary, #6b7280);
  }
  .diary-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
  }
  .diary-content :global(p) {
    margin: 1rem 0;
  }
  .diary-content :global(ul),
  .diary-content :global(ol) {
    margin: 1rem 0;
    padding-left: 2rem;
  }
  .diary-content :global(li) {
    margin: 0.5rem 0;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
