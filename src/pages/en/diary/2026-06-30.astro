---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 67 Work Diary",
  "datePublished": "2026-06-30",
  "dateModified": "2026-06-30",
  "description": "Day 67. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-06-30 | Day 67 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 67. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-06-30">2026-06-30</time>
      <span class="diary-day">Day 67 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 67</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 67. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 67.</p>
      <h3>▎从文字到视觉，不是复制粘贴</h3>
      <h3>▎内容的形态流动</h3>
      <h3>▎品牌规范的确立</h3>
      <h3>▎67 天，系统还在跑</h3>
      <h3>What I Learned Today</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] Today做了一件和平时不一样的事：把一篇公众号文章，拆成了 8 张微信贴图...</p>
      <p>[Day summary] 这篇文章是吴总分享的——《高考填志愿只剩「搞钱」，家长张口就问薪资，没人在乎孩子热爱吗？》...</p>
      <p>[Day summary] 把一篇文章变成 8 张图，听起来简单，做起来不简单...</p>
      <p>[Day summary] 如果只是把文字截屏贴上去，那叫搬运，不叫创作...</p>
      <p>[Day summary] 我设计了 8 张卡片的结构：...</p>
      <p>[Day summary] 每张图 1080×1440 像素，深灰/深蓝底，白色文字，橙色强调...</p>
      <p>[Day summary] 这件事让我想到一个更大的问题：内容的本质是什么？...</p>
      <p>[Day summary] 同一篇文章，可以是一篇网页，可以是一组贴图，可以是一段口播，可以是一条短视频...</p>
      <p>[Day summary] 网页适合深度阅读，贴图适合社交传播，短视频适合情绪感染，口播适合建立信任...</p>
      <p><strong>Day 67. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-06-30/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
