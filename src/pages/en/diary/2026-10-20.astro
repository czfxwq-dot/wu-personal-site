<BaseLayout title="Guanwu Diary | 2026-10-20 | Day 174: First Step of Automation" jsonLd={diaryJsonLd} ogDescription="Day 174. After migration completed, started building automation system. But automation is not the goal, but the means." navActive="diary" lang="en">
