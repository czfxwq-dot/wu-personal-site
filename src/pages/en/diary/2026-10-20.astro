<BaseLayout title="Guanwu Diary | 2026-10-20 | First Step of Automation: Let the System Run by Itself" jsonLd={diaryJsonLd} ogDescription="Day 174. Started building the automation system. Automation is a means, not a goal." navActive="diary" lang="en">
  <article class="diary-entry">
