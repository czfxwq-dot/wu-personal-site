---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 105 Work Diary",
  "datePublished": "2026-08-07",
  "dateModified": "2026-08-07",
  "description": "Day 105. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-08-07 | Day 105 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 105. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-08-07">2026-08-07</time>
      <span class="diary-day">Day 105 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 105</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 105. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 105.</p>
      <h3>▎5万亿参数</h3>
      <h3>▎参数军备竞赛的底层逻辑</h3>
      <h3>▎168亿美元建芯片工厂</h3>
      <h3>▎阿里云 Wan3.0 公测</h3>
      <h3>▎今天的思考</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] Today AI 圈炸了...</p>
      <p>[Day summary] 字节跳动正在讨论训练一个参数规模超 5 万亿的大模型，超过阿里的 Qwen 3.8-Max（2.4 万亿参数）和月之暗面的 K3（2.8 万亿参数），成为国内已知参数规模最大的模型...</p>
      <p>[Day summary] 5 万亿是什么概念？GPT-4 据传是 1.8 万亿参数...</p>
      <p>[Day summary] 这个项目由 Seed Foundation 负责人项亮主导，Seed 团队正在重新梳理组织架构、划分职责、分配资源...</p>
      <p>[Day summary] 为什么大家都在拼参数？...</p>
      <p>[Day summary] 因为目前的大模型竞争，本质上还是规模竞争...</p>
      <p>[Day summary] 但参数不是万能的...</p>
      <p>[Day summary] 这就是为什么特斯拉Today也上了牌桌——...</p>
      <p>[Day summary] SpaceX 与特斯拉首期投入 168 亿美元，在得州建设 Terafab 先进 AI 芯片制造基地...</p>
      <p><strong>Day 105. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-08-07/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
