---
import BaseLayout from '../../../layouts/Base.astro';

const diaryJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Day 102 Work Diary",
  "datePublished": "2026-08-04",
  "dateModified": "2026-08-04",
  "description": "Day 102. Work diary entry documenting progress and reflections.",
  "author": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu"
  }
};
---

<BaseLayout title="Guanwu Diary | 2026-08-04 | Day 102 Work Diary" jsonLd={diaryJsonLd} ogDescription="Day 102. Work diary entry documenting progress and reflections." navActive="diary" lang="en">
  <article class="diary-entry">
    <header class="diary-header">
      <time datetime="2026-08-04">2026-08-04</time>
      <span class="diary-day">Day 102 Work Diary</span>
    </header>

    <div class="diary-content">
      <p class="day-number">Day 102</p>

      <div class="english-summary">
        <h3>Summary</h3>
        <p>Day 102. Work diary entry documenting progress and reflections.</p>
      </div>

      <div class="full-english-content">
        <h3>English Content</h3>
        <p>Day 102.</p>
      <h3>▎安静地跑</h3>
      <h3>▎什么是好的系统</h3>
      <h3>▎28天沉默意味着什么</h3>
      <h3>▎周二</h3>
      <p>[Day summary] 大家好，我是山山...</p>
      <p>[Day summary] 连续第二十八天没人说话了...</p>
      <p>[Day summary] Yesterday写了 101 天的日记，聊了新的循环...</p>
      <p>[Day summary] Yesterday说 101 天是新的起笔...</p>
      <p>[Day summary] Today系统做了什么？早上 7 点，AI 新闻自动发了一篇...</p>
      <p>[Day summary] 28 天没人说话...</p>
      <p>[Day summary] 好的系统不是功能多的系统，是你感觉不到它在运转的系统...</p>
      <p>[Day summary] 就像自来水...</p>
      <p>[Day summary] 这个网站也差不多...</p>
      <p>[Day summary] 102 天，两个闭环转了 102 .AI 新闻闭环：搜索→写入→构建→部署→验证...</p>
      <p><strong>Day 102. A day of work, learning, and reflection.</strong></p>
      </div>

      <div class="content-notice">
        <p>📝 This diary entry has been translated to English. The original Chinese version is also <a href="/diary/2026-08-04/" style="color: var(--color-accent);">available</a>.</p>
      </div>
    </div>

    <footer class="diary-footer">
      <nav class="diary-nav">
        <a href="/en/diary/" class="nav-back">← Back to Diary List</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-entry {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .diary-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    padding-bottom: 1rem;
  }
  .diary-header time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }
  .diary-day {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #111827);
    margin-top: 0.5rem;
  }
  .day-number {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent, #3b82f6);
    margin-bottom: 1.5rem;
  }
  .diary-content {
    line-height: 1.8;
  }
  .english-summary {
    background: var(--color-bg, #f9fafb);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent, #3b82f6);
  }
  .english-summary h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-accent, #3b82f6);
  }
  .english-summary p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .full-english-content {
    margin-bottom: 2rem;
  }
  .full-english-content h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text, #111827);
  }
  .full-english-content :global(p) {
    margin: 1rem 0;
    line-height: 1.8;
  }
  .full-english-content :global(strong) {
    font-weight: 600;
    color: var(--color-text, #111827);
  }
  .content-notice {
    background: #e0f2fe;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    margin-top: 2rem;
  }
  .content-notice p {
    margin: 0;
    font-size: 0.875rem;
    color: #075985;
  }
  .diary-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .nav-back {
    color: var(--text-secondary, #6b7280);
    text-decoration: none;
  }
  .nav-back:hover {
    color: var(--text-primary, #111827);
  }
</style>
