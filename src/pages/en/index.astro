---
import BaseLayout from '../../layouts/Base.astro';
import { diaries } from '../../data/diaries';
import { dailyNewsSummaries } from '../../data/ai-news-summary';
import { articles } from '../../data/articles';

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Guanwu | 50-Year-Old Using AI to Get Things Done",
  "description": "50-year-old entrepreneur uses AI to turn ideas into reality — co-founder of MonolithIoT, sharing AI tool practices, AIoT solutions, and digital smart inventory management",
  "url": "https://ban-bai.com/en/",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Guanwu",
    "url": "https://ban-bai.com"
  },
  "about": {
    "@type": "Person",
    "name": "Mr. Wu",
    "alternateName": "Guanwu",
    "jobTitle": "Co-founder",
    "worksFor": {
      "@type": "Organization",
      "name": "MonolithIoT (Changzhou) Co., Ltd."
    }
  },
  "keywords": ["AI tools", "AI adoption", "BanbaiGuan Vision", "AIoT", "digital inventory", "learn AI at 50", "AI productivity"]
};

const latest = diaries[0];
const latestSummary = dailyNewsSummaries[0];

// Hands-on pieces: things you can copy directly (tooling + method breakdowns)
const handsOn = articles.filter(a => a.tag === 'AI应用' || a.tag === '深度分析');

function truncate(str: string, maxLen: number): string {
  if (!str) return '';
  if (str.length <= maxLen) return str;
  return str.slice(0, maxLen) + '…';
}
---

<BaseLayout jsonLd={homeJsonLd} navActive="home" lang="en">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient-1"></div>
      <div class="hero-gradient-2"></div>
      <div class="hero-grain"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        <span>AI Practitioner · BanbaiGuan Vision</span>
      </div>
      <h1 class="hero-title">
        At 50, I use AI<br/>to turn ideas into reality
      </h1>
      <p class="hero-subtitle">
        Co-founder of MonolithIoT · AIoT Practitioner · BanbaiGuan Vision
      </p>
      <p class="hero-description">
        This is not a typical personal website.<br/>
        My AI assistant and I built it from scratch, together.<br/>
        <span style="font-size: 14px; color: var(--color-text-tertiary);">AI tool practices · Digital smart inventory management · My honest 50-year-old AI learning journey</span>
      </p>
      <div class="hero-actions">
        <a href="/en/banbaiguan/" class="btn btn-primary">Read {articles.length} field-tested articles <span class="btn-arrow">→</span></a>
        <a href="/en/about/" class="btn btn-ghost">Who I am</a>
      </div>
      <div class="hero-stats">
        <span class="hero-stat"><strong>{articles.length}</strong> long-form pieces</span>
        <span class="hero-stat-dot"></span>
        <span class="hero-stat"><strong>{diaries.length}</strong> work diary entries</span>
        <span class="hero-stat-dot"></span>
        <span class="hero-stat"><strong>3</strong> self-built automations</span>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <span class="scroll-line"></span>
      <span class="scroll-text">Scroll down</span>
    </div>
  </section>

  <!-- Entry Section -->
  <section class="entry-section">
    <div class="container">
      <div class="section-subtitle">What would you like to explore?</div>
      <div class="entry-cards">
        <a href="/en/hands-on/" class="entry-card entry-learn">
          <span class="entry-icon">🛠️</span>
          <div class="entry-info">
            <h3>Copy it and use it</h3>
            <p>{handsOn.length} hands-on breakdowns: from setup to automation</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
        <a href="/en/projects/" class="entry-card entry-business">
          <span class="entry-icon">🏗️</span>
          <div class="entry-info">
            <h3>See what I've actually shipped</h3>
            <p>3 systems, each with a number you can verify</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
        <a href="/en/banbaiguan/" class="entry-card entry-story">
          <span class="entry-icon">📖</span>
          <div class="entry-info">
            <h3>Read my judgement</h3>
            <p>{articles.length} long-form pieces + daily AI news</p>
          </div>
          <span class="entry-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest three: hand over the finished work -->
  <section class="content-grid">
    <div class="container">
      <div class="grid-header">
        <div class="section-title">Latest three</div>
        <a href="/en/banbaiguan/" class="section-more">All {articles.length} <span class="arrow">→</span></a>
      </div>
      <div class="latest-list">
        {articles.slice(0, 3).map((a) => (
          <a href={`/en/banbaiguan/${a.slug}/`} class="latest-item">
            <div class="latest-meta">
              <span class="latest-tag">{a.tagEn || a.tag}</span>
              <span class="latest-date">{a.date}</span>
            </div>
            <h3 class="latest-title">{a.titleEn || a.title}</h3>
            <p class="latest-excerpt">{truncate(a.excerptEn || a.excerpt, 110)}</p>
          </a>
        ))}
      </div>
      <div class="latest-side">
        <a href="/en/diary/" class="side-link">
          <span class="side-label">Latest diary</span>
          <span class="side-text">{latest.date} · {latest.titleEn}</span>
        </a>
        <a href="/en/ai-news/" class="side-link">
          <span class="side-label">Latest AI news</span>
          <span class="side-text">{latestSummary.date} · {latestSummary.newsItems.length} items</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Live AI Projects -->
  <section class="page-section">
    <div class="container">
      <div class="section-title">Running in production</div>
      <div class="projects-grid">
        <a href="/en/projects/#shanshan" class="project-card">
          <span class="project-icon">🦞</span>
          <h3>Shanshan AI Assistant</h3>
          <p>On-site chat that reads the latest articles, news and diary entries before answering; the guestbook auto-reply runs on it too</p>
          <p class="project-num">DeepSeek direct · rate limit 20 / 10 min</p>
          <span class="project-status status-live">● Live</span>
        </a>
        <a href="/en/projects/#automation" class="project-card">
          <span class="project-icon">📰</span>
          <h3>Content automation</h3>
          <p>Three scheduled jobs: news at dawn, diary draft at dusk, deployment as a safety net at night</p>
          <p class="project-num">6 sources · 5 items a day · 30–60s to deploy</p>
          <span class="project-status status-live">● Live</span>
        </a>
        <a href="/en/projects/#pipeline" class="project-card">
          <span class="project-icon">✍️</span>
          <h3>Writing pipeline</h3>
          <p>Topic scoring plus an 18-point drafting checklist — it produced every long-form piece here</p>
          <p class="project-num">{articles.length} pieces came out of it</p>
          <span class="project-status status-live">● Live</span>
        </a>
      </div>
      <div class="projects-more">
        <a href="/en/projects/" class="section-more">How these three were built <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- About Company: compressed to one strip -->
  <section class="company-strip-section">
    <div class="container">
      <div class="company-strip">
        <div class="company-strip-main">
          <span class="company-badge">National High-Tech Enterprise</span>
          <h2>MonolithIoT (Changzhou) Co., Ltd.</h2>
          <p>AI scenario solutions: multi-sensor fusion, AI storage middleware, multimodal algorithms. Trusted by State Grid, Huawei, SF Express and DHL.</p>
        </div>
        <div class="company-strip-actions">
          <a href="/en/about/" class="link-arrow">Learn more</a>
          <a href="https://www.monolithiot.com" class="link-arrow" target="_blank" rel="noopener">Company site →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Follow Section -->
  <section class="follow-section">
    <div class="container">
      <div class="section-title" style="text-align: center;">Follow Us</div>
      <p class="follow-subtitle">Search "BanbaiGuan Vision" on all platforms to find us</p>
      <div class="follow-qr-codes">
        <div class="follow-qr-item">
          <img src="/gzh-qr.jpg" alt="WeChat BanbaiGuan Vision" loading="lazy" />
          <span class="follow-qr-label">WeChat</span>
        </div>
        <div class="follow-qr-item">
          <img src="/dy-qr.jpg" alt="Video Account BanbaiGuan Vision" loading="lazy" />
          <span class="follow-qr-label">Video Account</span>
        </div>
        <div class="follow-qr-item">
          <img src="/douyin-qr.jpg" alt="Douyin BanbaiGuan Vision" loading="lazy" />
          <span class="follow-qr-label">Douyin</span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero 动画时序 — 其余样式已由 global.css 提供 */
  .hero-eyebrow { animation: fadeInUp 0.6s ease forwards; animation-delay: 0.1s; }
  .hero-title { animation: fadeInUp 0.8s ease forwards; animation-delay: 0.2s; }
  .hero-subtitle { animation: fadeInUp 0.8s ease forwards; animation-delay: 0.35s; }
  .hero-description { animation: fadeInUp 0.8s ease forwards; animation-delay: 0.5s; }
  .hero-actions { animation: fadeInUp 0.8s ease forwards; animation-delay: 0.65s; }
  .hero-scroll-hint { animation: fadeIn 0.6s ease forwards; animation-delay: 1.2s; }

  .btn-arrow { transition: transform 0.2s; }
  .btn-primary:hover .btn-arrow { transform: translateX(4px); }

  .hero-stats {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-top: 28px; opacity: 0;
    animation: fadeInUp 0.8s ease forwards; animation-delay: 0.8s;
  }
  .hero-stat { font-size: 13px; color: var(--color-text-secondary); }
  .hero-stat strong { font-weight: 600; font-size: 15px; color: var(--color-accent); margin-right: 2px; }
  .hero-stat-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--color-gold); }

  .latest-list { display: flex; flex-direction: column; }
  .latest-item {
    display: block; padding: 18px 0; text-decoration: none;
    border-top: 1px solid var(--color-border-light);
    transition: padding-left 0.2s ease;
  }
  .latest-item:first-child { border-top: none; }
  .latest-item:hover { padding-left: 8px; }
  .latest-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .latest-tag {
    font-size: 11px; padding: 2px 8px; border-radius: 20px;
    background: rgba(200, 164, 92, 0.12); color: var(--color-gold); font-weight: 500;
  }
  .latest-date { font-size: 12px; color: var(--color-text-tertiary); }
  .latest-title { font-size: 17px; font-weight: 600; color: var(--color-text); margin: 0 0 6px; line-height: 1.45; }
  .latest-item:hover .latest-title { color: var(--color-accent); }
  .latest-excerpt { font-size: 13.5px; color: var(--color-text-secondary); line-height: 1.65; margin: 0; }
  .latest-side {
    display: flex; gap: 20px; flex-wrap: wrap; margin-top: 18px;
    padding-top: 16px; border-top: 1px dashed var(--color-border);
  }
  .side-link { display: flex; align-items: baseline; gap: 8px; text-decoration: none; font-size: 13px; }
  .side-label { color: var(--color-text-tertiary); font-size: 12px; }
  .side-text { color: var(--color-text-secondary); }
  .side-link:hover .side-text { color: var(--color-accent); }

  a.project-card { display: block; text-decoration: none; }
  .project-num {
    font-size: 12.5px !important; color: var(--color-gold) !important;
    margin: 0 0 12px !important; letter-spacing: 0.01em;
  }
  .projects-more { margin-top: 20px; text-align: right; }

  .company-strip-section { padding: 40px 0 56px; }
  .company-strip {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 24px; background: var(--color-surface);
    border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
  }
  .company-strip h2 { font-size: 17px; margin: 6px 0; color: var(--color-text); }
  .company-strip p { font-size: 13px; color: var(--color-text-secondary); margin: 0; line-height: 1.6; max-width: 640px; }
  .company-strip-actions { display: flex; gap: 16px; flex-shrink: 0; }

  @media (max-width: 768px) {
    .company-strip { flex-direction: column; align-items: flex-start; }
    .projects-more { text-align: left; }
  }
</style>
