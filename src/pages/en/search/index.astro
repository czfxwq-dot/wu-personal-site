---
import BaseLayout from '../../../layouts/Base.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "SearchAction",
  "name": "Search | Guanwu",
  "description": "Search all articles, diaries and AI news on Guanwu's site",
  "url": "https://ban-bai.com/en/search/",
  "inLanguage": "en"
};
---

<BaseLayout lang="en" title="Search | Guanwu" jsonLd={pageJsonLd} ogDescription="Search all articles, diaries and AI news" navActive="search">
  <div class="search-page">
    <div class="search-header">
      <h1>🔍 Search</h1>
      <p>Search all articles, diaries and AI news</p>
    </div>

    <div class="search-box">
      <div id="search-results" class="search-results"></div>
    </div>
  </div>
</BaseLayout>

<!-- Pagefind UI -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<style>
  .search-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .search-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .search-header h1 {
    font-family: var(--font-serif);
    font-size: 28px;
    margin: 0 0 8px;
  }

  .search-header p {
    color: var(--color-text-light);
    margin: 0;
  }

  .search-results {
    margin-top: 24px;
  }

  /* Pagefind 样式覆盖 */
  .pagefind-ui {
    border: none !important;
    padding: 0 !important;
  }

  .pagefind-ui__search-input {
    width: 100% !important;
    padding: 14px 20px !important;
    font-size: 16px !important;
    border: 2px solid var(--color-border) !important;
    border-radius: 12px !important;
    background: var(--color-bg) !important;
    color: var(--color-text) !important;
    outline: none !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--color-accent) !important;
  }

  .pagefind-ui__result {
    border-bottom: 1px solid var(--color-border) !important;
    padding: 16px 0 !important;
  }

  .pagefind-ui__result-title {
    font-size: 18px !important;
    font-weight: 600 !important;
  }

  .pagefind-ui__result-title a {
    color: var(--color-text) !important;
    text-decoration: none !important;
  }

  .pagefind-ui__result-title a:hover {
    color: var(--color-accent) !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--color-text-secondary) !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
  }

  .pagefind-ui__result-url {
    color: var(--color-accent) !important;
    font-size: 12px !important;
  }

  .pagefind-ui__message {
    color: var(--color-text-light) !important;
    text-align: center !important;
    padding: 20px !important;
  }
</style>

<script is:inline>
  // 初始化 Pagefind。页面 <html lang="en">，Pagefind 会自动加载英文索引，
  // 所以这里搜到的是英文页面；UI 文案也直接用英文覆盖。
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({
      element: "#search-results",
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: "Search the site...",
        clear_search: "Clear",
        load_more: "Load more results",
        search_empty: "No results found",
        search: {
          placeholder: "Search",
          clear: "Clear",
          close: "Close"
        }
      }
    });
  });
</script>
