{
  "name": "wu-personal-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --source docs",
    "preview": "astro preview",
    "check:data": "node scripts/sync-data.mjs check",
    "fix:data": "node scripts/sync-data.mjs fix",
    "guard": "bash scripts/pre-deploy-guard.sh",
    "deploy:cf": "source .env && npx wrangler pages deploy docs --project-name wu-personal-site --branch master --commit-dirty=true",
    "deploy": "node scripts/sync-data.mjs deploy && npm run build && npm run guard && npm run deploy:cf"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-sealedbox-js": "^1.2.0",
    "tweetnacl-util": "^0.15.1"
  }
}
